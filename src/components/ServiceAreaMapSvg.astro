<style>
  .map-svg {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-body);
  }

  .map-svg :global([data-route]) {
    filter: drop-shadow(0 0 1.5px rgba(11, 37, 69, 0.9));
    animation: sedco-map-flow 6s linear infinite;
  }

  .map-svg :global([data-beacon]) {
    transform-box: fill-box;
    transform-origin: center;
    animation: sedco-map-beacon 2.4s ease-out infinite;
  }

  .map-svg :global([data-beacon] + [data-beacon]) {
    animation-delay: 1.2s;
  }

  @keyframes sedco-map-flow {
    to {
      stroke-dashoffset: -200;
    }
  }

  @keyframes sedco-map-beacon {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-svg :global([data-route]),
    .map-svg :global([data-beacon]) {
      animation: none;
    }

    .map-svg :global([data-beacon]) {
      opacity: 0;
    }
  }
</style>
