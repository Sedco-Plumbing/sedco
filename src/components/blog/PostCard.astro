---
/**
 * Blog post card: image, category, title (the whole card is one link),
 * excerpt and date · reading time. `featured` is the wide horizontal version
 * used for the newest post on the blog index.
 */
import { Image } from 'astro:assets';
import { paths } from '@config/site';
import { images } from '@lib/images';
import { formatDate, isoDate, readingMinutes, type Post } from '@lib/blog';
import Icon from '@components/ui/Icon.astro';

interface Props {
  post: Post;
  featured?: boolean;
  /** Heading level for the title, to fit the page's outline */
  as?: 'h2' | 'h3';
  /** Load the image eagerly (the first card on the page) */
  eager?: boolean;
}

const { post, featured = false, as: Tag = 'h3', eager = false } = Astro.props;
const { data } = post;
const href = paths.post(post.id);
---

<article class:list={['post-card', featured && 'post-card--featured']}>
  <div class="post-card__media">
    <Image
      src={data.featuredImage ?? images.blogDefault.src}
      alt={data.featuredImageAlt || images.blogDefault.alt}
      widths={featured ? [640, 960, 1280] : [400, 640, 800]}
      sizes={featured ? '(max-width: 959px) calc(100vw - 48px), 640px' : '(max-width: 768px) calc(100vw - 48px), (max-width: 1199px) 45vw, 380px'}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class="post-card__img"
    />
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      <span class="post-card__cat">{data.category}</span>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(post)} min read</span>
    </p>
    <Tag class="post-card__title"><a href={href}>{data.title}</a></Tag>
    <p class="post-card__excerpt">{data.excerpt}</p>
    <p class="post-card__foot">
      <time datetime={isoDate(data.publishDate)}>{formatDate(data.publishDate)}</time>
      <span class="post-card__more" aria-hidden="true">Read article<Icon name="arrow-right" size={16} /></span>
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--white);
    transition:
      box-shadow var(--t-base) ease,
      transform var(--t-base) var(--ease-out),
      border-color var(--t-base) ease;
  }

  .post-card:hover {
    border-color: var(--blue-200);
    box-shadow: var(--shadow-card);
    transform: translateY(-3px);
  }

  .post-card:focus-within {
    outline: 3px solid var(--blue-600);
    outline-offset: 3px;
  }

  .post-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--slate-200);
  }

  .post-card__media :global(.post-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .post-card:hover :global(.post-card__img) {
    transform: scale(1.03);
  }

  .post-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 26px 26px;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--slate-500);
  }

  .post-card__cat {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-600);
  }

  .post-card__title {
    font-weight: 700;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-card__title a {
    color: var(--navy-800);
    text-decoration: none;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  /* The whole card is clickable through the title link. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card__excerpt {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--slate-600);
  }

  .post-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
    color: var(--slate-500);
  }

  .post-card__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--blue-600);
  }

  /* ---- featured (horizontal) ---- */

  .post-card--featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    border-radius: var(--r-2xl);
  }

  .post-card--featured .post-card__media {
    aspect-ratio: auto;
    min-height: 380px;
  }

  .post-card--featured .post-card__body {
    justify-content: center;
    gap: 16px;
    padding: 48px 48px 44px;
  }

  .post-card--featured .post-card__title {
    font-weight: 800;
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .post-card--featured .post-card__excerpt {
    -webkit-line-clamp: 4;
    font-size: 17px;
  }

  .post-card--featured .post-card__foot {
    margin-top: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card:hover,
    .post-card:hover :global(.post-card__img) {
      transform: none;
    }
  }

  @media (max-width: 959px) {
    .post-card--featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-card--featured .post-card__media {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .post-card--featured .post-card__body {
      padding: 28px 26px 26px;
    }

    .post-card--featured .post-card__title {
      font-size: 26px;
    }
  }
</style>
