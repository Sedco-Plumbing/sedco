---
/**
 * BlogPosting schema for blog posts, publisher referenced by @id so the
 * business entity is stated once, on the homepage.
 */
import { absolute, BUSINESS_ID, site } from '@config/site';
import { t } from '@lib/tokens';
import JsonLd from './JsonLd.astro';

interface Props {
  headline: string;
  description: string;
  path: string;
  published: Date;
  updated?: Date;
  author: string;
  /** Absolute image URL (Google requires an image for article rich results) */
  image?: string;
  section?: string;
  wordCount?: number;
}

const { headline, description, path, published, updated, author, image, section, wordCount } = Astro.props;

const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline,
  description: t(description),
  url: absolute(path),
  mainEntityOfPage: { '@type': 'WebPage', '@id': absolute(path) },
  inLanguage: 'en-US',
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  author: { '@type': 'Organization', name: author || site.business.name, url: absolute('/about/') },
  publisher: { '@id': BUSINESS_ID },
};

if (image) data.image = image.startsWith('http') ? image : absolute(image);
if (section) data.articleSection = section;
if (wordCount) data.wordCount = wordCount;
---

<JsonLd data={data} />
