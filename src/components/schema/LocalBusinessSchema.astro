---
/**
 * Site-wide business entity (guide Part 7.1 template A).
 *
 * Rendered once on every page by BaseLayout, so the Service, AboutPage and
 * other schema on any page can reference it by `@id` and always find it in
 * full. One component, one `@id`, so the entity is never published with
 * conflicting data.
 *
 * Service-area business: no street address, locality/region/ZIP only.
 */
import { site, absolute, BUSINESS_ID } from '@config/site';
import { t, isPlaceholder } from '@lib/tokens';
import JsonLd from './JsonLd.astro';

const { business, profiles } = site;

const sameAs = [profiles.google, profiles.yelp, profiles.facebook].filter(
  (url) => !isPlaceholder(url) && url.length > 0,
);

const address: Record<string, unknown> = {
  '@type': 'PostalAddress',
  addressLocality: business.locality,
  addressRegion: business.region,
  addressCountry: business.country,
};
if (!isPlaceholder(business.postalCode)) address.postalCode = business.postalCode;

/** "(619) 714-0027" -> "+1-619-714-0027" (E.164-style, as schema validators prefer) */
const phone = t('[PHONE]');
const digits = phone.replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '');
const telephone =
  digits.length === 10 ? `+1-${digits.slice(0, 3)}-${digits.slice(3, 6)}-${digits.slice(6)}` : phone;

/**
 * "Mo-Sa 00:00-23:59" -> OpeningHoursSpecification. Days left out are closed.
 * Anything this can't parse falls back to the plain `openingHours` string.
 */
const DAYS = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
const DAY_NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const hoursSpec = (value: string) => {
  const specs = [];
  for (const part of value.split(',').map((p) => p.trim())) {
    const m = part.match(/^(Mo|Tu|We|Th|Fr|Sa|Su)(?:-(Mo|Tu|We|Th|Fr|Sa|Su))? (\d\d:\d\d)-(\d\d:\d\d)$/);
    if (!m) return null;
    const from = DAYS.indexOf(m[1]);
    const to = m[2] ? DAYS.indexOf(m[2]) : from;
    if (to < from) return null;
    specs.push({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: DAY_NAMES.slice(from, to + 1),
      opens: m[3],
      closes: m[4],
    });
  }
  return specs;
};

const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': BUSINESS_ID,
  name: business.name,
  url: absolute('/'),
  telephone,
  email: t('[EMAIL]'),
  // SEO team's (Her Brand Bureau) business description, composed from config.
  description: `Licensed ${business.licenseClass} plumbing contractor based in ${business.locality}, ${business.region}, serving homes and businesses across ${business.county}.`,
  // Social share photo (1200x630); the logo stays the 512px square Google asks for.
  image: absolute('/images/social/sedco-plumbing-el-cajon-1200x630.jpg'),
  logo: absolute('/images/brand/sedco-plumbing-logo-512.png'),
  address,
  areaServed: [
    ...site.cities.map((city) => ({
      '@type': 'City',
      name: `${city.name}, ${business.region}`,
      address: city.zips.map((zip) => ({
        '@type': 'PostalAddress',
        addressLocality: city.name,
        addressRegion: business.region,
        postalCode: zip,
        addressCountry: business.country,
      })),
    })),
    { '@type': 'AdministrativeArea', name: `${business.county}, ${business.region}` },
  ],
  priceRange: business.priceRange,
};

if (sameAs.length > 0) data.sameAs = sameAs;
if (!isPlaceholder(business.hoursSchema)) {
  const spec = hoursSpec(business.hoursSchema);
  if (spec) data.openingHoursSpecification = spec;
  else data.openingHours = business.hoursSchema;
}
---

<JsonLd data={data} />
