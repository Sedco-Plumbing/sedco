---
/**
 * Site-wide business entity (guide Part 7.1 template A).
 *
 * Lives on the homepage, every city page (which the guide specifies as
 * "LocalBusiness (Plumber) with areaServed") and every service and
 * service x city page, where the Service schema's provider points to it by
 * `@id`. The same `@id` and data are emitted everywhere, so the entity is
 * referenced consistently rather than published with conflicting data.
 *
 * Service-area business: no street address, locality/region/ZIP only.
 */
import { site, absolute, BUSINESS_ID } from '@config/site';
import { t, isPlaceholder } from '@lib/tokens';
import JsonLd from './JsonLd.astro';

const { business, profiles } = site;

const sameAs = [profiles.google, profiles.yelp, profiles.facebook].filter(
  (url) => !isPlaceholder(url) && url.length > 0,
);

const address: Record<string, unknown> = {
  '@type': 'PostalAddress',
  addressLocality: business.locality,
  addressRegion: business.region,
  addressCountry: business.country,
};
if (!isPlaceholder(business.postalCode)) address.postalCode = business.postalCode;

const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': BUSINESS_ID,
  name: business.name,
  url: absolute('/'),
  telephone: t('[PHONE]'),
  email: t('[EMAIL]'),
  // SEO team's LocalBusiness schema description, composed from config so it stays correct per client.
  description: `${business.name} is a locally owned plumbing company based in ${business.locality}, ${business.regionName}, serving homeowners and businesses throughout ${business.county}.`,
  // 512px square logo (Google asks for at least 112px).
  image: absolute('/images/brand/sedco-plumbing-logo-512.png'),
  logo: absolute('/images/brand/sedco-plumbing-logo-512.png'),
  address,
  areaServed: [
    ...site.cities.map((city) => ({ '@type': 'City', name: city.name })),
    { '@type': 'AdministrativeArea', name: business.county },
  ],
  priceRange: business.priceRange,
};

if (sameAs.length > 0) data.sameAs = sameAs;
if (!isPlaceholder(business.hoursSchema)) data.openingHours = business.hoursSchema;
---

<JsonLd data={data} />
