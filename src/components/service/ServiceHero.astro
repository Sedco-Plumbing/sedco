---
/**
 * Split hero for service (and service × city) pages. Left: breadcrumb, the
 * "5.0 on Google" pill, eyebrow, H1, lead, buttons, and the perks strip under
 * them. Right (desktop): the job-site photo. On phones the photo is swapped
 * for the service's illustration via <picture>, so only one image downloads.
 */
import { site, paths } from '@config/site';
import { phoneHref } from '@lib/tokens';
import { SERVICE_HERO_PHOTO_SIZES, SERVICE_HERO_ART_SIZES, type ImageKey } from '@lib/media';
import images from '../../data/images.json';
import Icon from '@components/ui/Icon.astro';
import Stars from '@components/ui/Stars.astro';
import type { Crumb } from '@lib/types';
import type { IconName } from '@lib/icons';

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  heading: string;
  lead: string;
  /** Illustration shown on phones */
  art: ImageKey;
  /** Service name pre-selected in the request drawer */
  service?: string;
}

const { crumbs, eyebrow, heading, lead, art, service } = Astro.props;
const photo = images['hero/sedco-plumber-el-cajon'];
const illustration = images[art];

const perks: { icon: IconName; label: string }[] = [
  { icon: 'free-estimate', label: 'Free estimate' },
  { icon: 'no-trip-charge', label: 'No trip charge' },
  { icon: 'guarantee', label: '30-day guarantee' },
  { icon: 'licensed', label: `Licensed CA ${site.business.licenseClass}` },
];
---

<section class="svc-hero" aria-labelledby="svc-hero-heading">
  <div class="svc-hero__content">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {
          crumbs.map((crumb, index) => (
            <li>
              {crumb.href && index < crumbs.length - 1 ? (
                <a href={crumb.href}>{crumb.name}</a>
              ) : (
                <span aria-current="page">{crumb.name}</span>
              )}
              {index < crumbs.length - 1 && <Icon name="chevron-right" size={14} />}
            </li>
          ))
        }
      </ol>
    </nav>

    <a class="rating-pill" href={paths.reviews}>
      <Stars size={16} />
      <span>5.0 on Google</span>
    </a>

    <p class="svc-hero__eyebrow">{eyebrow}</p>
    <h1 class="svc-hero__title" id="svc-hero-heading">{heading}</h1>
    <p class="svc-hero__lead">{lead}</p>

    <picture class="svc-hero__media">
      <source media="(max-width: 768px)" srcset={illustration.srcset} sizes={SERVICE_HERO_ART_SIZES} />
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={SERVICE_HERO_PHOTO_SIZES}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </picture>

    <div class="svc-hero__ctas">
      <a class="btn btn--call btn--lg" href={phoneHref()}>
        <Icon name="phone" size={22} />Call {site.business.phone}
      </a>
      <a class="btn btn--request btn--lg" href={`${paths.contact}#request`} data-open-request data-service={service}>
        Request Service
      </a>
    </div>

    <ul class="svc-hero__perks">
      {
        perks.map((perk) => (
          <li>
            <Icon name={perk.icon} size={20} />
            {perk.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .svc-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: repeat(6, auto) 1fr;
    min-height: 640px;
    margin: 0 var(--section-inset);
    overflow: hidden;
    border-radius: var(--r-section);
    background: var(--navy-800);
  }

  /* Children are laid out on the hero's grid directly. */
  .svc-hero__content {
    display: contents;
  }

  .crumbs,
  .rating-pill,
  .svc-hero__eyebrow,
  .svc-hero__title,
  .svc-hero__lead,
  .svc-hero__ctas,
  .svc-hero__perks {
    grid-column: 1;
    margin-left: max(64px, calc((50vw - var(--section-inset) - 600px) / 2 + 40px));
    margin-right: 64px;
  }

  .crumbs {
    grid-row: 1;
    align-self: start;
    margin-top: 56px;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    list-style: none;
    font-size: 15px;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--blue-200);
  }

  .crumbs a {
    color: var(--blue-200);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .crumbs [aria-current] {
    font-weight: 600;
    color: var(--white);
  }

  .crumbs :global(svg) {
    color: var(--blue-300);
  }

  .rating-pill {
    grid-row: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.1);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
  }

  .rating-pill:hover {
    background: rgba(255, 255, 255, 0.16);
    color: var(--white);
  }

  .rating-pill:focus-visible {
    outline-color: var(--blue-300);
  }

  .svc-hero__eyebrow {
    grid-row: 3;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow-500);
  }

  .svc-hero__title {
    grid-row: 4;
    margin-top: 14px;
    font-weight: 800;
    font-size: 60px;
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  .svc-hero__lead {
    grid-row: 5;
    max-width: 560px;
    margin-top: 22px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--blue-100);
  }

  .svc-hero__ctas {
    grid-row: 6;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .svc-hero__ctas .btn--lg {
    padding: 0 26px;
    font-size: 18px;
  }

  .svc-hero__ctas .btn:focus-visible {
    outline-color: var(--white);
  }

  /* ---- photo + perks (desktop) ---- */

  .svc-hero__media {
    grid-column: 2;
    grid-row: 1 / span 7;
    position: relative;
    display: block;
    min-height: 100%;
  }

  .svc-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  /* Soft edge where the photo meets the navy panel */
  .svc-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--navy-800) 0%, rgba(11, 37, 69, 0.55) 22%, rgba(11, 37, 69, 0) 48%);
  }

  /* Under the buttons, in the left column */
  .svc-hero__perks {
    grid-row: 7;
    align-self: start;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 14px 40px;
    margin-top: 28px;
    margin-bottom: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--navy-600);
    list-style: none;
  }

  .svc-hero__perks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    white-space: nowrap;
  }

  .svc-hero__perks :global(svg) {
    color: var(--yellow-500);
  }

  @media (max-width: 1199px) {
    .svc-hero__title {
      font-size: 48px;
    }

    .crumbs,
    .rating-pill,
    .svc-hero__eyebrow,
    .svc-hero__title,
    .svc-hero__lead,
    .svc-hero__ctas,
    .svc-hero__perks {
      margin-left: 48px;
      margin-right: 40px;
    }
  }

  /* ---- stacked (tablet + mobile) ---- */
  @media (max-width: 959px) {
    .svc-hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 28px 20px;
    }

    .crumbs,
    .rating-pill,
    .svc-hero__eyebrow,
    .svc-hero__title,
    .svc-hero__lead,
    .svc-hero__ctas {
      margin-left: 0;
      margin-right: 0;
    }

    .crumbs {
      margin-top: 0;
    }

    .crumbs ol {
      font-size: 14px;
    }

    .rating-pill {
      align-self: flex-start;
      margin-top: 18px;
    }

    .svc-hero__eyebrow {
      margin-top: 18px;
      font-size: 12px;
    }

    .svc-hero__title {
      font-size: 34px;
      line-height: 1.08;
      letter-spacing: -0.02em;
    }

    .svc-hero__lead {
      margin-top: 14px;
      font-size: 16px;
      line-height: 1.55;
    }

    .svc-hero__media {
      position: static;
      min-height: 0;
      margin: 20px auto 0;
    }

    .svc-hero__media::after {
      display: none;
    }

    .svc-hero__media img {
      position: static;
      width: min(280px, 72vw);
      height: auto;
      aspect-ratio: 1;
      object-fit: contain;
      filter: drop-shadow(0 20px 22px rgba(0, 0, 0, 0.35));
    }

    .svc-hero__ctas,
    .svc-hero__perks {
      align-self: stretch;
    }

    .svc-hero__ctas {
      flex-direction: column;
      margin-top: 20px;
      margin-bottom: 0;
    }

    .svc-hero__ctas .btn {
      width: 100%;
    }

    .svc-hero__perks {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 12px;
      margin: 24px 0 0;
      padding: 20px 0 0;
      border-top: 1px solid var(--navy-600);
      border-radius: 0;
      background: transparent;
    }

    .svc-hero__perks li {
      font-size: 14px;
      white-space: normal;
    }
  }

  /* Between phone and desktop the photo stays a photo, shown as a banner. */
  @media (min-width: 769px) and (max-width: 959px) {
    .svc-hero__media {
      width: 100%;
      margin-top: 24px;
    }

    .svc-hero__media img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: var(--r-xl);
      filter: none;
    }
  }
</style>
