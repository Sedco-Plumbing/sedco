---
/**
 * "… Across San Diego County": one chip per town. A chip links to the
 * service × town page where one exists, otherwise to the town's page.
 */
import Icon from '@components/ui/Icon.astro';

interface Props {
  heading: string;
  text: string;
  chips: { href: string; label: string; current?: boolean }[];
  id?: string;
}

const { heading, text, chips, id = 'areas' } = Astro.props;
---

<section class="chips-section" id={id} aria-labelledby={`${id}-heading`}>
  <div class="chips-section__panel">
    <h2 class="chips-section__title" id={`${id}-heading`}>{heading}</h2>
    <p class="chips-section__text">{text}</p>
    <ul class="chips-section__list">
      {
        chips.map((chip) => (
          <li>
            <a href={chip.href} aria-current={chip.current ? 'page' : undefined}>
              <Icon name="map-pin" size={16} />
              {chip.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .chips-section {
    padding: 24px var(--gutter) 72px;
  }

  .chips-section__panel {
    max-width: var(--container);
    margin: 0 auto;
    padding: 40px;
    border-radius: var(--r-2xl);
    background: #eef4fb;
  }

  .chips-section__title {
    font-weight: 800;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .chips-section__text {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--slate-600);
  }

  .chips-section__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    list-style: none;
  }

  .chips-section__list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--white);
    font-size: 15px;
    font-weight: 600;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      border-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .chips-section__list a:hover,
  .chips-section__list a[aria-current] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  @media (max-width: 768px) {
    .chips-section {
      padding: 8px 16px 40px;
    }

    .chips-section__panel {
      padding: 28px 20px;
      border-radius: 22px;
    }

    .chips-section__title {
      font-size: 23px;
    }

    .chips-section__list a {
      padding: 0 14px;
      font-size: 14px;
    }
  }
</style>
