---
/**
 * Sticky sidebar on service pages: a navy call card, then the "On this page"
 * menu. A small scroll-spy marks the section currently being read (the last
 * one whose top has passed 180px). Hidden on narrow screens, where the page
 * shows an inline call card instead.
 */
import { site, paths } from '@config/site';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
import type { TocItem } from '@lib/types';

interface Props {
  heading: string;
  text: string;
  toc: TocItem[];
  service?: string;
}

const { heading, text, toc, service } = Astro.props;
---

<aside class="svc-aside" aria-label="Call or request service">
  <div class="call-card on-navy">
    <p class="call-card__title">{heading}</p>
    <p class="call-card__text">{text}</p>
    <a class="btn btn--call btn--block call-card__btn" href={phoneHref()}>
      <Icon name="phone" size={18} />{site.business.phone}
    </a>
    <a class="btn btn--request btn--block call-card__btn" href={`${paths.contact}#request`} data-open-request data-service={service}>
      Request Service
    </a>
  </div>

  <nav class="toc" aria-label="On this page" data-toc>
    <p class="toc__title">On this page</p>
    <ul>
      {
        toc.map((item, index) => (
          <li>
            <a href={`#${item.id}`} aria-current={index === 0 ? 'true' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .svc-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .call-card {
    padding: 24px;
    border-radius: var(--r-2xl);
    background: var(--navy-800);
  }

  .call-card__title {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.2;
    color: var(--white);
  }

  .call-card__text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--blue-200);
  }

  .call-card__btn {
    height: 52px;
    font-size: 16px;
    margin-top: 10px;
  }

  .call-card__btn:first-of-type {
    margin-top: 20px;
  }

  .toc {
    padding: 22px 12px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    background: var(--white);
  }

  .toc__title {
    padding: 0 12px 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate-500);
  }

  .toc ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .toc a:hover,
  .toc a[aria-current] {
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .toc a[aria-current] {
    font-weight: 600;
  }

  @media (max-width: 1099px) {
    .svc-aside {
      display: none;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);

    let frame = 0;
    const update = () => {
      frame = 0;
      let active = 0;
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top < 180) active = index;
      });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>
