---
/**
 * A heading, an intro line and a 3-column grid of white cards, e.g. the
 * drain cleaning page's "Drains We Clear".
 */
import Icon from '@components/ui/Icon.astro';

interface Props {
  id: string;
  heading: string;
  intro?: string;
  items: { title: string; text: string }[];
}

const { id, heading, intro, items } = Astro.props;
---

<section class="article-section covers" id={id} aria-labelledby={`${id}-heading`}>
  <h2 class="article-h2" id={`${id}-heading`}>{heading}</h2>
  {intro && <p class="article-lead">{intro}</p>}
  <ul class="covers__grid">
    {
      items.map((item) => (
        <li>
          <Icon name="check" size={20} strokeWidth={2.5} />
          <h3 class="covers__title">{item.title}</h3>
          <p class="covers__text">{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .covers__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
    list-style: none;
  }

  .covers__grid li {
    padding: 24px;
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .covers__grid :global(svg) {
    color: var(--blue-600);
  }

  .covers__title {
    margin-top: 16px;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
  }

  .covers__text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--slate-600);
  }

  @media (max-width: 959px) {
    .covers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .covers__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
