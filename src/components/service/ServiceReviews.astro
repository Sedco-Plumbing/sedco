---
/**
 * "What Customers Say" on service pages: one featured review and two cards.
 * Reviews about this service come first (matched on the reviewer's own words
 * for the job), then the rest in their usual order.
 */
import { reviews } from '@config/reviews';
import { paths } from '@config/site';
import Stars from '@components/ui/Stars.astro';
import Icon from '@components/ui/Icon.astro';

interface Props {
  id: string;
  /** Words that identify this service in a review's `service` field, e.g. ["drain"] */
  match: string[];
}

const { id, match } = Astro.props;
const wanted = match.map((word) => word.toLowerCase());
const isMatch = (service: string) => wanted.some((word) => service.toLowerCase().includes(word));
const ordered = [...reviews.filter((r) => isMatch(r.service)), ...reviews.filter((r) => !isMatch(r.service))];
const [featured, ...rest] = ordered.slice(0, 3);
---

<section class="svc-reviews" id={id} aria-labelledby={`${id}-heading`}>
  <div class="svc-reviews__head">
    <h2 class="article-h2" id={`${id}-heading`}>What Customers Say</h2>
    <p class="svc-reviews__rating"><Stars size={16} /> <strong>5.0 on Google</strong></p>
  </div>

  <figure class="quote quote--featured">
    <Stars size={18} label="5 out of 5 stars" />
    <blockquote>“{featured.quote}”</blockquote>
    <figcaption>
      <span class="quote__avatar" aria-hidden="true">{featured.name.charAt(0)}</span>
      <span><strong>{featured.name}</strong><span>{featured.service} · {featured.source}</span></span>
    </figcaption>
  </figure>

  <div class="svc-reviews__pair">
    {
      rest.map((review) => (
        <figure class="quote">
          <Stars size={16} label="5 out of 5 stars" />
          <blockquote>“{review.quote}”</blockquote>
          <figcaption>
            <span class="quote__avatar" aria-hidden="true">{review.name.charAt(0)}</span>
            <span><strong>{review.name}</strong><span>{review.service} · {review.source}</span></span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <a class="svc-reviews__more" href={paths.reviews}>Read more reviews<Icon name="arrow-right" size={16} /></a>
</section>

<style>
  .svc-reviews__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .svc-reviews__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--navy-800);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .quote--featured {
    margin-top: 24px;
    padding: 32px;
  }

  .quote blockquote {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--navy-800);
  }

  .quote--featured blockquote {
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .quote figcaption > span:last-child {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--slate-500);
  }

  .quote figcaption strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--navy-800);
  }

  .quote__avatar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy-800);
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--yellow-500);
  }

  .svc-reviews__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .svc-reviews__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 12px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .svc-reviews__pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .quote--featured {
      padding: 24px;
    }

    .quote--featured blockquote {
      font-size: 17px;
    }
  }
</style>
