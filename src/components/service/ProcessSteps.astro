---
/**
 * Navy "How it works" card with a horizontal four-step timeline (numbered
 * yellow dots on a dashed line). Vertical list on narrow screens.
 */
interface Props {
  id: string;
  heading: string;
  lead: string;
  steps: { title: string; text: string }[];
}

const { id, heading, lead, steps } = Astro.props;
---

<section class="process" id={id} aria-labelledby={`${id}-heading`}>
  <p class="process__eyebrow">How it works</p>
  <h2 class="process__title" id={`${id}-heading`}>{heading}</h2>
  <p class="process__lead">{lead}</p>
  <ol class="process__steps">
    {
      steps.map((step, index) => (
        <li class="process__step">
          <span class="process__dot" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="process__step-title">{step.title}</h3>
          <p class="process__step-text">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    padding: 44px 40px 40px;
    border-radius: var(--r-2xl);
    background: var(--navy-800);
  }

  .process__eyebrow {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow-500);
  }

  .process__title {
    margin-top: 10px;
    font-weight: 800;
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .process__lead {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--blue-200);
  }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 14px;
    margin-top: 40px;
    list-style: none;
  }

  .process__step {
    position: relative;
  }

  /* Dashed connector from each dot to the next */
  .process__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 54px;
    right: -4px;
    border-top: 2px dashed rgba(255, 183, 3, 0.75);
  }

  .process__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--yellow-500);
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 15px;
    color: var(--navy-800);
  }

  .process__step-title {
    margin-top: 18px;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    color: var(--white);
  }

  .process__step-text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--blue-200);
  }

  @media (max-width: 768px) {
    .process {
      padding: 32px 22px;
      border-radius: var(--r-xl);
    }

    .process__title {
      font-size: 25px;
    }

    .process__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 28px;
    }

    .process__step {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: 16px;
    }

    .process__step:not(:last-child)::before {
      top: 52px;
      left: 21px;
      right: auto;
      bottom: -18px;
      border-top: 0;
      border-left: 2px dashed rgba(255, 183, 3, 0.75);
    }

    .process__dot {
      grid-row: 1 / span 2;
    }

    .process__step-title {
      margin-top: 10px;
    }
  }
</style>
