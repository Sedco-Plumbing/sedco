---
/**
 * "What You Can Count On": the 30-day guarantee tile (yellow) beside four
 * terms — Free Estimate, No Trip Charge, Same price, 24 Hours Open. All are
 * confirmed by the client. Sits inside the homepage How-it-works panel
 * (`as="h3"`) or as its own navy section on About (`standalone`).
 */
import { site, paths } from '@config/site';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';

interface Props {
  as?: 'h2' | 'h3';
  standalone?: boolean;
  id?: string;
}

const { as: Tag = 'h3', standalone = false, id = 'count-on' } = Astro.props;
---

<div class:list={['count-on', standalone && 'count-on--standalone']}>
  <div class="count-on__inner">
    <Tag class="count-on__title" id={`${id}-heading`}>What You Can Count On</Tag>
    <p class="count-on__lead">
      These terms are the same for every service we offer, so you get the same deal whether you need
      a blocked drain cleared or a new shower put in.
    </p>

    <div class="count-on__grid">
      <div class="guarantee">
        <svg class="guarantee__watermark" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
        <svg width="96" height="96" viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 38.5l-4.5 8 4.8-1.6 2.6 4.2 3.6-8.4" fill="#FFFFFF" stroke="#0B2545" stroke-width="1.5"></path><path d="M31 38.5l4.5 8-4.8-1.6-2.6 4.2-3.6-8.4" fill="#FFFFFF" stroke="#0B2545" stroke-width="1.5"></path><path d="M24 3l16 6v12c0 10.5-7 18.5-16 22.5C15 39.5 8 31.5 8 21V9z" fill="#0B2545" stroke="#0B2545" stroke-width="1.8"></path><path d="M24 7.5l12 4.5v9c0 8-5.2 14.3-12 17.5-6.8-3.2-12-9.5-12-17.5v-9z" stroke="#FFB703" stroke-width="1.2" stroke-dasharray="1.5 2.2"></path><path d="M17 22.5l4.6 4.6 9.4-9.4" stroke="#FFB703" stroke-width="3"></path><path d="M24 12.2l.8 1.7 1.8.2-1.4 1.2.4 1.8-1.6-.9-1.6.9.4-1.8-1.4-1.2 1.8-.2z" fill="#FFFFFF" stroke="none"></path><path d="M45 6v3 M43.5 7.5h3" stroke="#0B2545" stroke-width="1.6"></path><path d="M3 14v2.5 M1.75 15.25h2.5" stroke="#0B2545" stroke-width="1.6"></path></svg>
        <div>
          <p class="guarantee__big">30 days</p>
          <p class="guarantee__sub">Guarantee on all work</p>
        </div>
        <div class="guarantee__actions">
          <a class="btn btn--navy guarantee__request" href={`${paths.contact}#request`} data-open-request>
            Request Service<Icon name="arrow-right" size={18} strokeWidth={2.5} />
          </a>
          <a class="btn btn--outline-navy guarantee__call" href={phoneHref()}>
            <Icon name="phone" size={18} />Call {site.business.phone}
          </a>
        </div>
      </div>

      <ul class="terms">
        <li class="term">
          <svg width="60" height="60" viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="10" y="8" width="24" height="32" rx="3" stroke="#FFB703" stroke-width="2"></rect><path d="M17 8V6.5A1.5 1.5 0 0 1 18.5 5h7A1.5 1.5 0 0 1 27 6.5V8" stroke="#FFB703" stroke-width="2"></path><path d="M15.5 18.5l2 2 3.5-3.5 M15.5 26.5l2 2 3.5-3.5" stroke="#FFB703" stroke-width="2"></path><path d="M24.5 19h5 M24.5 27h5 M15.5 34h9" stroke="#96C6F5" stroke-width="1.6"></path><path d="M33 41l9-9 3 3-9 9h-3z" stroke="#96C6F5" stroke-width="1.6"></path></svg>
          <div>
            <p class="term__title">Free Estimate</p>
            <p class="term__text">You get a clear price for the work before anything starts.</p>
          </div>
        </li>
        <li class="term">
          <svg width="60" height="60" viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 31V16.5A1.5 1.5 0 0 1 5.5 15H28v16" stroke="#FFB703" stroke-width="2"></path><path d="M28 20h7.5l6.5 6.5V31H28" stroke="#FFB703" stroke-width="2"></path><circle cx="12" cy="32" r="4" stroke="#FFB703" stroke-width="2"></circle><circle cx="34" cy="32" r="4" stroke="#FFB703" stroke-width="2"></circle><path d="M8 21h14 M8 25.5h9" stroke="#96C6F5" stroke-width="1.6"></path><path d="M3 41h42" stroke="#96C6F5" stroke-width="1.6" stroke-dasharray="3 3"></path></svg>
          <div>
            <p class="term__title">No Trip Charge</p>
            <p class="term__text">No call-out fee for coming out to see the problem.</p>
          </div>
        </li>
        <li class="term">
          <svg width="60" height="60" viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M30 7a15 15 0 1 0 12 22A12 12 0 0 1 30 7z" stroke="#FFB703" stroke-width="2"></path><path d="M38 6v4 M36 8h4 M43 15v3 M41.5 16.5h3" stroke="#96C6F5" stroke-width="1.6"></path></svg>
          <div>
            <p class="term__title">Same price</p>
            <p class="term__text">Night and Saturday calls, as weekdays</p>
          </div>
        </li>
        <li class="term">
          <svg width="60" height="60" viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="25" r="17" stroke="#FFB703" stroke-width="2"></circle><path d="M24 12v2.5 M24 35.5V38 M11 25h2.5 M34.5 25H37" stroke="#96C6F5" stroke-width="1.6"></path><path d="M24 17v8l5.5 3.5" stroke="#FFB703" stroke-width="2.2"></path><path d="M38 7.5a21 21 0 0 1 5.5 8 M44 11.5l-.5 4-3.8-1.4" stroke="#96C6F5" stroke-width="1.6"></path></svg>
          <div>
            <p class="term__title">24 Hours Open</p>
            <p class="term__text">Monday to Saturday</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>

<style>
  .count-on__title {
    font-weight: 800;
    font-size: 34px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--white);
  }

  .count-on__lead {
    max-width: 620px;
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--blue-200);
  }

  .count-on__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 12px;
    margin-top: 32px;
  }

  .guarantee {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 32px;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--yellow-500);
    color: var(--navy-800);
  }

  .guarantee__watermark {
    position: absolute;
    right: -28px;
    bottom: -28px;
    opacity: 0.12;
  }

  .guarantee__big {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 64px;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .guarantee__sub {
    margin-top: 12px;
    font-family: var(--font-title);
    font-size: 24px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .guarantee__actions {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .guarantee__actions .btn {
    width: 100%;
    height: 56px;
    font-size: 17px;
  }

  .guarantee__request {
    font-weight: 700;
  }

  .guarantee__request :global(svg) {
    color: var(--yellow-500);
  }

  .guarantee__request:hover {
    background: var(--navy-700);
  }

  .guarantee__actions .btn:focus-visible {
    outline-color: var(--navy-800);
  }

  .terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
  }

  .term {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
    border: 1px solid var(--navy-600);
    border-radius: var(--r-xl);
    background: var(--navy-700);
  }

  .term svg {
    flex: none;
  }

  .term__title {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 26px;
    line-height: 1.05;
    color: var(--white);
  }

  .term__text {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--blue-200);
  }

  /* ---- standalone navy section (About page) ---- */
  .count-on--standalone {
    margin: 24px var(--section-inset);
    padding: 96px clamp(24px, 5vw, 64px);
    border-radius: var(--r-section);
    background: var(--navy-800);
  }

  .count-on--standalone .count-on__inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .count-on--standalone .count-on__title {
    font-size: 44px;
  }

  @media (max-width: 959px) {
    .count-on__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .count-on__title,
    .count-on--standalone .count-on__title {
      font-size: 26px;
    }

    .count-on--standalone {
      margin: 16px var(--section-inset);
      padding: 40px 20px;
      border-radius: var(--r-2xl);
    }

    .guarantee {
      padding: 24px;
    }

    .guarantee__big {
      font-size: 52px;
    }

    .terms {
      grid-template-columns: minmax(0, 1fr);
    }

    .term {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      padding: 18px;
    }

    .term svg {
      width: 48px;
      height: 48px;
    }

    .term__title {
      font-size: 22px;
    }
  }
</style>
