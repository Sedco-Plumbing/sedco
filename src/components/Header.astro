---
/**
 * Site header (sticky). Desktop: the logo aligned with the page container,
 * the nav (Services mega menu, Service Areas dropdown), then the service search
 * and Call + Request Service pushed to the right edge. Mobile (≤ 1279px): logo,
 * search and a menu button that opens the slide-in menu; Call and Request
 * Service live in the sticky bottom bar.
 *
 * The menus are progressive: every trigger is also a plain link target, so the
 * site navigates without JavaScript. Closed menus are `display: none`, which
 * keeps the 17 lazy thumbnails in the mega menu from downloading until it opens.
 *
 * "Request Service" carries [data-open-request]; RequestDrawer.astro turns it
 * into the slide-in form. Without JS it falls through to the contact page form.
 */
import { site, paths } from '@config/site';
import { catalogGroups, serviceHref } from '@config/catalog';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
import ResponsiveImage from '@components/ui/ResponsiveImage.astro';
import HeaderSearch from './HeaderSearch.astro';
import MobileMenu from './MobileMenu.astro';

const phone = site.business.phone;
const tel = phoneHref();
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="bar">
    <a class="brand" href={paths.home} aria-label={`${site.business.name} home`}>
      <img
        src="/images/brand/sedco-plumbing-logo-84w.webp"
        alt=""
        width="44"
        height="44"
        class="brand__logo"
      />
      <span class="brand__name">{site.business.name}</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a class="nav__item" href={paths.home} aria-current={current === paths.home ? 'page' : undefined} data-menu-close>Home</a>
      <a
        class="nav__item"
        href={paths.servicesHub}
        aria-expanded="false"
        aria-controls="mega-menu"
        aria-current={isCurrent(paths.servicesHub) ? 'page' : undefined}
        data-menu-trigger="mega"
      >
        Services<Icon name="chevron-down" size={14} strokeWidth={2.5} class="nav__chev" />
      </a>
      <div class="nav__areas" data-areas-wrap>
        <a
          class="nav__item"
          href={paths.areasHub}
          aria-expanded="false"
          aria-controls="areas-menu"
          aria-current={isCurrent(paths.areasHub) ? 'page' : undefined}
          data-menu-trigger="areas"
        >
          Service Areas<Icon name="chevron-down" size={14} strokeWidth={2.5} class="nav__chev" />
        </a>
        <div id="areas-menu" class="areas" data-menu="areas">
          <div class="areas__card">
            <ul class="areas__list">
              {
                site.cities.map((city) => (
                  <li>
                    <a href={paths.city(city.slug)}>
                      <Icon name="map-pin" size={16} />
                      {city.name}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="areas__all" href={paths.areasHub}>
              See all service areas<Icon name="arrow-right" size={16} strokeWidth={2.5} />
            </a>
          </div>
        </div>
      </div>
      <a class="nav__item" href={paths.reviews} aria-current={isCurrent(paths.reviews) ? 'page' : undefined} data-menu-close>Reviews</a>
      <a class="nav__item" href={paths.about} aria-current={isCurrent(paths.about) ? 'page' : undefined} data-menu-close>About</a>
      <a class="nav__item" href={paths.blog} aria-current={isCurrent(paths.blog) ? 'page' : undefined} data-menu-close>Blog</a>
      <a class="nav__item" href={paths.contact} aria-current={isCurrent(paths.contact) ? 'page' : undefined} data-menu-close>Contact</a>
    </nav>

    <HeaderSearch />

    <div class="ctas">
      <a class="btn btn--call btn--sm" href={tel}>
        <Icon name="phone" size={20} />
        {phone}
      </a>
      <a class="btn btn--request btn--sm" href={`${paths.contact}#request`} data-open-request>
        <Icon name="free-estimate" size={20} />
        Request Service
      </a>
    </div>

    <div class="mobile-ctas">
      <button
        type="button"
        class="icon-btn icon-btn--menu"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-toggle
      >
        <Icon name="menu" size={24} strokeWidth={2.4} />
      </button>
    </div>
  </div>

  <div id="mega-menu" class="mega" data-menu="mega" role="region" aria-label="Services menu">
    <div class="mega__cols">
      {
        catalogGroups.map((group) => (
          <div class="mega__col">
            <p class="mega__title">{group.menuTitle}</p>
            <ul>
              {group.services.map((service) => (
                <li>
                  <a href={serviceHref(service)} aria-current={current === serviceHref(service) ? 'page' : undefined}>
                    <ResponsiveImage name={service.image} alt="" sizes="56px" class="mega__thumb" />
                    {service.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mega__strip">
      <div class="mega__hours">
        <span class="mega__clock"><Icon name="clock" size={22} /></span>
        <div>
          <p class="mega__hours-title">Open 24 hours, Monday to Saturday.</p>
          <p class="mega__hours-note">Closed Sunday.</p>
        </div>
      </div>
      <div class="mega__actions on-navy">
        <a class="btn btn--outline-dark btn--md" href={paths.servicesHub}>
          View all services<Icon name="arrow-right" size={16} strokeWidth={2.5} />
        </a>
        <a class="btn btn--call btn--md" href={tel}>
          <Icon name="phone" size={18} />Call {phone}
        </a>
        <a class="btn btn--request btn--md" href={`${paths.contact}#request`} data-open-request>Request Service</a>
      </div>
    </div>
  </div>

  <MobileMenu />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--page);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header-h);
    /* Logo lines up with the page container; the actions sit at the right edge. */
    padding: 0 32px 0 max(var(--gutter), calc((100% - var(--container)) / 2));
  }

  .brand {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--navy-800);
    text-decoration: none;
    border-radius: var(--r-sm);
  }

  .brand:hover {
    color: var(--navy-800);
  }

  .brand:focus-visible {
    outline-offset: 4px;
  }

  .brand__logo {
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
  }

  .brand__name {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* ---- desktop nav ---- */

  .nav {
    display: flex;
    margin-inline: auto;
  }

  .nav__item {
    flex: none;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 12px;
    border-radius: var(--r-sm);
    font: 500 16px var(--font-body);
    color: var(--navy-800);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }

  /* The current page's item: navy text, slightly bolder. */
  .nav__item[aria-current='page'] {
    font-weight: 600;
    color: var(--navy-800);
  }

  /* Hover, keyboard focus and an open menu: deep navy with yellow text,
     matching the mega-menu and dropdown rows. Declared after the current-page
     rule so it also wins on the current item. */
  .nav__item:hover,
  .nav__item:focus-visible,
  .nav__item[aria-expanded='true'] {
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .nav__item :global(.nav__chev) {
    flex: none;
    transition: transform 200ms ease;
  }

  .nav__item[aria-expanded='true'] :global(.nav__chev) {
    transform: rotate(180deg);
  }

  .nav__areas {
    position: relative;
  }

  .ctas {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ctas .btn--request {
    padding: 0 16px;
  }

  /* ---- shared menu motion: display:none when closed ---- */

  .areas,
  .mega {
    display: none;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      display 200ms allow-discrete;
  }

  .areas[data-open],
  .mega[data-open] {
    display: block;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .areas[data-open],
    .mega[data-open] {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* ---- Service Areas dropdown ---- */

  .areas {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 30;
    padding-top: 14px;
  }

  .areas__card {
    width: 280px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-dropdown);
  }

  .areas__list {
    display: flex;
    flex-direction: column;
    padding: 8px;
    list-style: none;
  }

  .areas__list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 500;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .areas__list a:hover,
  .areas__list a:focus-visible {
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .areas__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-top: 1px solid var(--line);
    background: var(--sky-50);
    font-size: 15px;
    font-weight: 600;
    color: var(--blue-600);
    text-decoration: none;
  }

  /* ---- Services mega menu ---- */

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    z-index: 30;
    border-top: 1px solid var(--line);
    background: var(--white);
    box-shadow: var(--shadow-menu);
  }

  .mega__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 40px;
  }

  .mega__col {
    padding: 0 22px;
  }

  .mega__col + .mega__col {
    border-left: 1px solid var(--line);
  }

  .mega__title {
    margin: 0 0 6px;
    padding: 0 0 14px;
    border-bottom: 2px solid var(--yellow-500);
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 16px;
    line-height: 1.25;
    color: var(--navy-800);
  }

  .mega__col ul {
    list-style: none;
  }

  .mega__col li + li {
    border-top: 1px dashed var(--line);
  }

  .mega__col li a {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 -10px;
    padding: 12px 10px;
    border-radius: var(--r-md);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .mega__col li a:hover,
  .mega__col li a:focus-visible,
  .mega__col li a[aria-current='page'] {
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .mega :global(.mega__thumb) {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    object-fit: cover;
  }

  .mega__strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px max(40px, calc((100% - 1360px) / 2));
    background: var(--navy-800);
  }

  .mega__hours {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mega__clock {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: var(--navy-700);
    color: var(--yellow-500);
  }

  .mega__hours-title {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 18px;
    color: var(--white);
  }

  .mega__hours-note {
    margin-top: 2px;
    font-size: 14px;
    color: var(--blue-300);
  }

  .mega__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mega__actions .btn--outline-dark {
    margin-right: 6px;
    padding: 0 18px;
  }

  /* ---- mobile ---- */

  .mobile-ctas {
    display: none;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    color: var(--navy-800);
  }


  /* Deep navy with a yellow icon, so the menu button stands out. */
  .icon-btn--menu {
    border: 0;
    background: var(--navy-800);
    color: var(--yellow-500);
    box-shadow: 0 6px 16px rgba(11, 37, 69, 0.25);
    cursor: pointer;
    transition: background-color var(--t-fast) ease;
  }

  .icon-btn--menu:hover,
  .icon-btn--menu:active {
    background: var(--navy-700);
  }

  /* With the logo held on the container line, the bar gets tighter as the
     screen narrows: trim spacing and type a step rather than drop items. */
  @media (max-width: 1599px) {
    .nav__item {
      padding: 0 8px;
    }
  }

  @media (max-width: 1439px) {
    .bar {
      gap: 12px;
      padding-right: 24px;
    }

    .brand__name {
      font-size: 20px;
    }

    .nav__item {
      padding: 0 6px;
      font-size: 15px;
    }

    .ctas {
      gap: 6px;
    }

    .ctas .btn {
      padding: 0 14px;
      font-size: 15px;
    }
  }

  @media (max-width: 1279px) {
    .nav,
    .ctas,
    .mega,
    .mega[data-open] {
      display: none;
    }

    .bar {
      gap: 8px;
      padding: 0 16px 0 20px;
    }

    .brand {
      margin-right: auto;
    }

    .mobile-ctas {
      display: flex;
      gap: 8px;
    }

  }


  @media (max-width: 768px) {
    .brand {
      gap: 10px;
    }

    .brand__logo {
      width: 40px;
      height: 40px;
    }

    .brand__name {
      font-size: 19px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    type MenuName = 'mega' | 'areas';
    const triggers = {
      mega: header.querySelector<HTMLAnchorElement>('[data-menu-trigger="mega"]'),
      areas: header.querySelector<HTMLAnchorElement>('[data-menu-trigger="areas"]'),
    };
    const menus = {
      mega: header.querySelector<HTMLElement>('[data-menu="mega"]'),
      areas: header.querySelector<HTMLElement>('[data-menu="areas"]'),
    };
    const desktop = window.matchMedia('(min-width: 1280px)');
    const hoverable = window.matchMedia('(hover: hover)');
    let areasTimer: number | undefined;

    const isOpen = (name: MenuName) => menus[name]?.hasAttribute('data-open') ?? false;

    const setOpen = (name: MenuName, open: boolean) => {
      menus[name]?.toggleAttribute('data-open', open);
      triggers[name]?.setAttribute('aria-expanded', String(open));
    };

    const open = (name: MenuName) => {
      window.clearTimeout(areasTimer);
      document.dispatchEvent(new CustomEvent('sedco:menu-open'));
      setOpen(name === 'mega' ? 'areas' : 'mega', false);
      setOpen(name, true);
    };

    const closeAll = () => {
      window.clearTimeout(areasTimer);
      setOpen('mega', false);
      setOpen('areas', false);
    };

    // Click/tap/Enter toggles. The trigger is a real link to the hub page, so a
    // second activation while open navigates there.
    (Object.keys(triggers) as MenuName[]).forEach((name) => {
      triggers[name]?.addEventListener('click', (event) => {
        if (!desktop.matches) return;
        if (!isOpen(name)) {
          event.preventDefault();
          open(name);
        }
      });
    });

    // Hover opens on pointer devices.
    triggers.mega?.addEventListener('mouseenter', () => {
      if (desktop.matches && hoverable.matches) open('mega');
    });
    const areasWrap = header.querySelector<HTMLElement>('[data-areas-wrap]');
    areasWrap?.addEventListener('mouseenter', () => {
      if (desktop.matches && hoverable.matches) open('areas');
    });
    areasWrap?.addEventListener('mouseleave', () => {
      if (!hoverable.matches) return;
      areasTimer = window.setTimeout(() => setOpen('areas', false), 120);
    });
    header.addEventListener('mouseleave', () => {
      if (hoverable.matches) setOpen('mega', false);
    });
    header.querySelectorAll('[data-menu-close]').forEach((link) =>
      link.addEventListener('mouseenter', () => {
        if (hoverable.matches) closeAll();
      }),
    );

    // Escape closes and returns focus to the trigger that owns the open menu.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openName = (['mega', 'areas'] as MenuName[]).find(isOpen);
      if (openName) {
        closeAll();
        triggers[openName]?.focus();
      }
    });

    // Close when focus or a click moves outside the header.
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) closeAll();
    });
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !header.contains(next)) closeAll();
    });

    // Opening the service search closes every menu.
    document.addEventListener('sedco:search-open', closeAll);

    desktop.addEventListener('change', closeAll);
  }
</script>
