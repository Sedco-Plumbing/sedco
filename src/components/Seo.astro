---
/**
 * Per-page SEO head tags.
 *
 * Title and description come verbatim from each page's spec block in the
 * content guide — no suffix is appended, because those strings are the spec.
 * Every page gets a self-referencing canonical (guide Part 7.4).
 */
import { site, absolute } from '@config/site';
import { t } from '@lib/tokens';

interface Props {
  /** Title tag, exactly as specified in the guide */
  title: string;
  /** Meta description, exactly as specified in the guide */
  description: string;
  /** Site-relative path of this page, with trailing slash */
  path: string;
  /** Optional social share image; defaults to the 1200×630 branded share card */
  ogImage?: string;
  /** Article publish date for blog posts */
  publishedTime?: Date;
  noindex?: boolean;
  /** Off for the 404 page, which is served at whatever URL was not found */
  canonical?: boolean;
}

const { title, description, path, ogImage, publishedTime, noindex = false, canonical: withCanonical = true } = Astro.props;

const canonical = absolute(path);
/** Branded 1200×630 card: logo, "Licensed Plumber in El Cajon, CA" and the phone number. */
const DEFAULT_SHARE_IMAGE = '/images/social/sedco-plumbing-el-cajon-1200x630.jpg';
const shareImage = absolute(ogImage ?? DEFAULT_SHARE_IMAGE);
const isDefaultImage = !ogImage;
const resolvedTitle = t(title);
const resolvedDescription = t(description);
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
{withCanonical && <link rel="canonical" href={canonical} />}

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
<meta property="og:site_name" content={site.business.name} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
{withCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={shareImage} />
{
  isDefaultImage && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Sedco Plumbing, licensed plumber in El Cajon, CA. Call (619) 714-0027." />
    </>
  )
}
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={shareImage} />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="geo.region" content={`US-${site.business.region}`} />
<meta name="geo.placename" content={site.business.locality} />
