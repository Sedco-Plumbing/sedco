---
/**
 * Request-service form, posted to Web3Forms so leads land in Sedco's inbox.
 * Used by the Request drawer, the contact section on every page and the
 * homepage hero estimate card.
 *
 *  - variant="standard"  Name*, Phone*, ZIP*, What do you need?, What's happening?
 *  - variant="compact"   Name*, Phone*, City*, Service*, Brief description (hero card)
 *
 * States: form → error alert (role="alert") → success (role="status"). On a
 * confirmed submission it pushes `form_submit_lead` to the GTM dataLayer.
 * Validation runs on the client; the browser's own validation is turned off
 * (novalidate) so every field gets the same visible error message.
 */
import { site, paths } from '@config/site';
import { requestServiceOptions, requestCityOptions } from '@config/catalog';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';

interface Props {
  /** Unique prefix for field ids on the page */
  id: string;
  variant?: 'standard' | 'compact';
  /** Pre-selected service name (catalog name), e.g. on a service page */
  service?: string;
  /** Pre-selected city name, e.g. on a town page */
  city?: string;
  /** Show a Close button in the success state (drawer only) */
  closeButton?: boolean;
  /** Short name of where the form sits, sent with the lead, e.g. "drawer" */
  source: string;
}

const { id, variant = 'standard', service, city, closeButton = false, source } = Astro.props;
const compact = variant === 'compact';
const accessKey = site.integrations.web3formsKey;
const phone = site.business.phone;
const tel = phoneHref();
---

<div class:list={['request-form', compact && 'request-form--compact']} data-request-form-root>
  <form
    class="request-form__form"
    data-request-form
    data-source={source}
    novalidate
    aria-label={compact ? 'Get a free estimate' : 'Request service'}
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={`New service request — ${site.business.name} website`} />
    <input type="hidden" name="from_name" value={`${site.business.name} website`} />
    <input type="hidden" name="form" value={source} />
    <input type="hidden" name="page" value="" data-page-field />
    <!-- Web3Forms honeypot: real visitors never see or fill it -->
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />

    <div class="field">
      <label class="field__label" for={`${id}-name`}>
        Name {!compact && <span class="field__hint">Required</span>}
      </label>
      <input
        class="input"
        id={`${id}-name`}
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby={`${id}-name-error`}
      />
      <p class="field__error" id={`${id}-name-error`}>Please enter your name.</p>
    </div>

    <div class="field">
      <label class="field__label" for={`${id}-phone`}>
        Phone {!compact && <span class="field__hint">Required</span>}
      </label>
      <input
        class="input"
        id={`${id}-phone`}
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        aria-describedby={`${id}-phone-error`}
      />
      <p class="field__error" id={`${id}-phone-error`}>Please enter a phone number we can call you back on.</p>
    </div>

    {
      compact ? (
        <div class="field">
          <label class="field__label" for={`${id}-city`}>Service address city</label>
          <div class="select">
            <select class="input" id={`${id}-city`} name="city" required aria-describedby={`${id}-city-error`}>
              <option value="">Your city...</option>
              {requestCityOptions.map((option) => (
                <option selected={option === city}>{option}</option>
              ))}
            </select>
            <Icon name="chevron-down" size={18} />
          </div>
          <p class="field__error" id={`${id}-city-error`}>Please choose the city the job is in.</p>
        </div>
      ) : (
        <div class="field">
          <label class="field__label" for={`${id}-zip`}>
            ZIP code <span class="field__hint">Required</span>
          </label>
          <input
            class="input"
            id={`${id}-zip`}
            name="zip"
            type="text"
            inputmode="numeric"
            autocomplete="postal-code"
            maxlength="10"
            required
            aria-describedby={`${id}-zip-help ${id}-zip-error`}
          />
          <p class="field__help" id={`${id}-zip-help`}>So we know where to send our plumber.</p>
          <p class="field__error" id={`${id}-zip-error`}>Please enter a 5-digit ZIP code.</p>
        </div>
      )
    }

    <div class="field">
      <label class="field__label" for={`${id}-service`}>
        {compact ? 'What do you need help with?' : 'What do you need?'}
      </label>
      <div class="select">
        <select
          class="input"
          id={`${id}-service`}
          name="service"
          required={compact}
          aria-describedby={compact ? `${id}-service-error` : undefined}
        >
          {compact && <option value="">Choose a service...</option>}
          {
            requestServiceOptions
              .filter((option) => !(compact && option === 'Not sure'))
              .map((option) => <option selected={option === service}>{option}</option>)
          }
        </select>
        <Icon name="chevron-down" size={18} />
      </div>
      {compact && <p class="field__error" id={`${id}-service-error`}>Please choose a service.</p>}
    </div>

    <div class="field field--wide">
      <label class="field__label" for={`${id}-details`}>
        {compact ? 'Brief description' : "What's happening?"}
        {!compact && <span class="field__hint">Optional</span>}
      </label>
      <textarea
        class="input"
        id={`${id}-details`}
        name="details"
        rows={compact ? 2 : 4}
        aria-describedby={compact ? undefined : `${id}-details-help`}></textarea>
      {
        !compact && (
          <p class="field__help" id={`${id}-details-help`}>
            A short note is enough, for example which sink is blocked or how long the leak has been
            going on.
          </p>
        )
      }
    </div>

    <div class="form-alert field--wide" role="alert" data-form-error hidden>
      <Icon name="alert-circle" size={22} />
      <p>
        Sorry, your request didn't go through this time. Please try again, or call us at
        <a href={tel}>{phone}</a> so that we can help you right away.
      </p>
    </div>

    <div class="request-form__submit field--wide">
      <button class="btn btn--call btn--block request-form__button" type="submit">
        <span data-submit-label>Send Request</span>
        {!compact && <Icon name="arrow-right" size={18} strokeWidth={2.25} />}
      </button>
      <p class="form-privacy">
        {!compact && <Icon name="lock" size={15} />}
        We only use these details to reply to your request.
        <a href={paths.privacy}>Read our privacy policy.</a>
      </p>
    </div>
  </form>

  <div class="form-success" role="status" data-form-success hidden>
    <span class="form-success__icon"><Icon name="check" size={32} strokeWidth={2.25} /></span>
    <p>
      Thanks, we've got your request. We'll call you back within 30 minutes from Monday to
      Saturday, and if the problem is urgent, please call us now at <a href={tel}>{phone}</a>.
    </p>
    {
      closeButton && (
        <button type="button" class="btn btn--navy btn--md" data-drawer-close>
          Close
        </button>
      )
    }
  </div>
</div>

<style>
  .request-form__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .request-form__submit {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .request-form__button {
    height: 60px;
    border-radius: 14px;
    font-size: 18px;
  }

  .request-form__button:hover {
    background: var(--yellow-400);
    transform: scale(1.02);
  }

  .request-form__button:active {
    background: var(--yellow-600);
    transform: scale(0.99);
  }

  .request-form__button[disabled] {
    cursor: progress;
    opacity: 0.8;
    transform: none;
  }

  /* ---- compact (hero estimate card) ---- */

  .request-form--compact .request-form__form {
    gap: 12px;
  }

  .request-form--compact :global(.field__label) {
    margin-bottom: 6px;
  }

  .request-form--compact :global(.input) {
    height: 50px;
    border: 1.5px solid var(--slate-500);
    border-radius: 10px;
    background: var(--white);
  }

  .request-form--compact :global(.input:focus) {
    outline-color: var(--blue-300);
  }

  .request-form--compact :global(textarea.input) {
    min-height: 72px;
    padding: 12px 16px;
  }

  .request-form--compact .request-form__submit {
    gap: 12px;
  }

  .request-form--compact .request-form__button {
    height: 56px;
    border-radius: var(--r-md);
    font-size: 19px;
  }

  .request-form--compact .request-form__button:hover {
    background: var(--yellow-600);
    transform: none;
  }

  .request-form--compact :global(.form-privacy) {
    justify-content: flex-start;
    color: var(--slate-600);
    text-align: left;
  }

  @media (max-width: 768px) {
    .request-form__form {
      gap: 20px;
    }

    .request-form :global(.input) {
      border: 1.5px solid var(--slate-500);
      border-radius: 10px;
      background: var(--white);
    }

    .request-form :global(.form-privacy) {
      justify-content: flex-start;
      font-size: 15px;
      color: var(--slate-600);
      text-align: left;
    }

    .request-form__button {
      border-radius: var(--r-md);
      font-size: 19px;
    }
  }
</style>

<script>
  const PHONE_RE = /^[\d\s()+.\-]{7,}$/;
  const ZIP_RE = /^\d{5}(-\d{4})?$/;

  document.querySelectorAll<HTMLFormElement>('[data-request-form]').forEach((form) => {
    const root = form.closest<HTMLElement>('[data-request-form-root]');
    const success = root?.querySelector<HTMLElement>('[data-form-success]');
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');

    const rules: Record<string, (value: string) => boolean> = {
      name: (v) => v.trim().length > 0,
      phone: (v) => PHONE_RE.test(v.trim()) && v.replace(/\D/g, '').length >= 10,
      zip: (v) => ZIP_RE.test(v.trim()),
      city: (v) => v.length > 0,
      service: (v) => v.length > 0,
    };

    /** Returns the first invalid field, or null when the form is valid. */
    const validate = (): HTMLElement | null => {
      let firstInvalid: HTMLElement | null = null;
      for (const [name, rule] of Object.entries(rules)) {
        const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
        if (!field || !field.required) continue;
        const ok = rule(field.value);
        field.closest('.field')?.toggleAttribute('data-invalid', !ok);
        field.setAttribute('aria-invalid', String(!ok));
        if (!ok && !firstInvalid) firstInvalid = field;
      }
      return firstInvalid;
    };

    form.addEventListener('input', (event) => {
      if ((event.target as HTMLElement).closest('.field[data-invalid]')) validate();
    });
    form.addEventListener('change', (event) => {
      if ((event.target as HTMLElement).closest('.field[data-invalid]')) validate();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorBox) errorBox.hidden = true;

      const invalid = validate();
      if (invalid) {
        invalid.focus();
        return;
      }

      const pageField = form.querySelector<HTMLInputElement>('[data-page-field]');
      if (pageField) pageField.value = window.location.href;

      const label = submitLabel?.textContent ?? '';
      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Sending…';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const result = await response.json();
        if (!response.ok || result.success === false) {
          throw new Error(result.message || 'Submission failed');
        }

        // Lead-conversion event for GTM — fires only once Web3Forms confirms
        // delivery, never on a click or a failed validation. `form_name` keeps
        // the pre-redesign value so existing triggers/reports still match;
        // `form_location` says which form it was (drawer, contact-section,
        // home-hero).
        const w = window as Window & { dataLayer?: unknown[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
          event: 'form_submit_lead',
          form_name: 'service_request',
          form_location: form.dataset.source,
        });

        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.setAttribute('tabindex', '-1');
          success.focus({ preventScroll: true });
          success.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      } catch {
        if (errorBox) errorBox.hidden = false;
      } finally {
        if (submit) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = label;
      }
    });
  });
</script>
