---
/**
 * Service search in the header. The magnifier button slides a panel down from
 * under the header (full width, its content lined up with the page
 * container) with "What service are you looking for?". As the visitor types,
 * matching services appear with their card illustration and name only;
 * choosing one opens its service page.
 *
 * Every service is rendered as a real link in the HTML (hidden until it
 * matches), so results need no data fetch. The panel is display:none while
 * closed, so the lazy thumbnails only download once someone searches.
 * Matching uses each service's name plus the search words in catalog.ts.
 * Keyboard: ↑/↓ move, Enter opens, Escape closes. ARIA combobox pattern.
 */
import { catalogServices, serviceHref, SEARCH_TERMS } from '@config/catalog';
import { site } from '@config/site';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
import ResponsiveImage from '@components/ui/ResponsiveImage.astro';

const options = catalogServices.map((service) => ({
  id: `search-opt-${service.slug}`,
  href: serviceHref(service),
  name: service.name,
  image: service.image,
  terms: [service.name, service.short, SEARCH_TERMS[service.slug] ?? ''].join(' ').toLowerCase(),
}));

const EXAMPLES = ['Drain clog', 'Water heater', 'Leak', 'Toilet', 'Gas line'];
---

<div class="search" data-search>
  <button
    type="button"
    class="search__toggle"
    aria-label="Search services"
    aria-expanded="false"
    aria-controls="site-search-panel"
    data-search-toggle
  >
    <Icon name="search" size={21} class="search__toggle-open" />
    <Icon name="close" size={20} class="search__toggle-close" />
  </button>

  <div class="search__panel" id="site-search-panel" role="search" data-search-panel>
    <div class="search__inner">
      <div class="search__field">
        <Icon name="search" size={22} class="search__glass" />
        <label class="visually-hidden" for="site-search-input">What service are you looking for?</label>
        <input
          id="site-search-input"
          class="search__input"
          type="text"
          placeholder="What service are you looking for?"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="site-search-list"
          data-search-input
        />
      </div>

      <div class="search__hint" data-search-hint>
        <span>Try:</span>
        {EXAMPLES.map((example) => (
          <button type="button" data-search-example={example.toLowerCase()}>{example}</button>
        ))}
      </div>

      <div class="search__results" data-search-results hidden>
        <ul class="search__list" id="site-search-list" role="listbox" aria-label="Matching services">
          {
            options.map((option) => (
              <li role="presentation" data-terms={option.terms} data-name={option.name.toLowerCase()} hidden>
                <a id={option.id} role="option" href={option.href} tabindex="-1" aria-selected="false">
                  <span class="search__thumb" aria-hidden="true">
                    <ResponsiveImage name={option.image} alt="" sizes="56px" class="search__img" />
                  </span>
                  <span class="search__name">{option.name}</span>
                  <Icon name="arrow-right" size={18} class="search__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="search__empty" data-search-empty hidden>
          No service matches that. Call <a href={phoneHref()}>{site.business.phone}</a> and we'll help.
        </p>
      </div>
      <p class="visually-hidden" aria-live="polite" data-search-status></p>
    </div>
  </div>
</div>

<style>
  .search {
    flex: none;
  }

  .search__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--blue-200);
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--navy-800);
    cursor: pointer;
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease,
      border-color var(--t-fast) ease;
  }

  .search__toggle:hover,
  .search__toggle[aria-expanded='true'] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .search__toggle :global(.search__toggle-close),
  .search__toggle[aria-expanded='true'] :global(.search__toggle-open) {
    display: none;
  }

  .search__toggle[aria-expanded='true'] :global(.search__toggle-close) {
    display: block;
  }

  /* ---- slide-down panel under the header ---- */

  .search__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    z-index: 35;
    display: none;
    border-top: 1px solid var(--line);
    background: var(--white);
    box-shadow: var(--shadow-menu);
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 240ms ease,
      transform 280ms var(--ease-out),
      display 280ms allow-discrete;
  }

  .search[data-open] .search__panel {
    display: block;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .search[data-open] .search__panel {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  .search__inner {
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 28px var(--gutter) 32px;
  }

  .search__field {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding: 0 20px;
    border: 1.5px solid var(--navy-800);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: 0 0 0 4px rgba(11, 116, 217, 0.12);
  }

  .search__field :global(.search__glass) {
    flex: none;
    color: var(--slate-500);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font: 500 18px var(--font-body);
    color: var(--ink);
  }

  .search__input::placeholder {
    color: var(--slate-500);
  }


  .search__hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 14px;
    color: var(--slate-600);
  }

  .search__hint button {
    height: 34px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--sky-50);
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-800);
    cursor: pointer;
  }

  .search__hint button:hover {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  /* ---- results ---- */

  .search__results {
    margin-top: 18px;
    max-height: min(460px, 60vh);
    overflow-y: auto;
  }

  .search__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
  }

  .search__list a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px 8px 8px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease,
      border-color var(--t-fast) ease;
  }

  .search__list a:hover,
  .search__list a[aria-selected='true'] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .search__thumb {
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--navy-800);
  }

  .search__thumb :global(.search__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search__name {
    flex: 1;
    min-width: 0;
  }

  .search__list :global(.search__arrow) {
    flex: none;
    color: var(--blue-600);
  }

  .search__list a:hover :global(.search__arrow),
  .search__list a[aria-selected='true'] :global(.search__arrow) {
    color: var(--yellow-500);
  }

  .search__empty {
    padding: 8px 2px;
    font-size: 15px;
    color: var(--slate-600);
  }

  .search__empty a {
    font-weight: 600;
  }

  @media (max-width: 1279px) {
    .search__toggle {
      width: 48px;
      height: 48px;
    }
  }

  @media (max-width: 768px) {
    .search__inner {
      padding: 16px 16px 20px;
    }

    .search__field {
      height: 54px;
      padding-left: 14px;
    }

    .search__input {
      font-size: 16px;
    }

    .search__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .search__results {
      max-height: 55vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search__panel {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-search]');

  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const results = root.querySelector<HTMLElement>('[data-search-results]')!;
    const empty = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const status = root.querySelector<HTMLElement>('[data-search-status]')!;
    const hint = root.querySelector<HTMLElement>('[data-search-hint]')!;
    const items = [...root.querySelectorAll<HTMLLIElement>('.search__list > li')];
    const MAX = 8;
    let visible: HTMLAnchorElement[] = [];
    let active = -1;

    const isOpen = () => root.hasAttribute('data-open');

    const setActive = (index: number) => {
      visible.forEach((a, i) => a.setAttribute('aria-selected', String(i === index)));
      active = index;
      if (index >= 0) {
        input.setAttribute('aria-activedescendant', visible[index].id);
        visible[index].scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    };

    /** Score a service against the query; lower is better, null = no match. */
    const score = (li: HTMLLIElement, words: string[], query: string): number | null => {
      const name = li.dataset.name ?? '';
      const terms = li.dataset.terms ?? '';
      const tokens = terms.split(/[^a-z0-9-]+/);
      const all = words.every((w) => tokens.some((t) => t.startsWith(w)) || terms.includes(w));
      if (!all) return null;
      if (name.startsWith(query)) return 0;
      if (name.split(/\s+/).some((t) => t.startsWith(words[0]))) return 1;
      return 2;
    };

    const update = () => {
      const query = input.value.trim().toLowerCase();
      if (!query) {
        results.hidden = true;
        hint.hidden = false;
        input.setAttribute('aria-expanded', 'false');
        visible = [];
        setActive(-1);
        status.textContent = '';
        return;
      }
      hint.hidden = true;
      const words = query.split(/\s+/);
      const ranked = items
        .map((li, order) => ({ li, order, s: score(li, words, query) }))
        .filter((r) => r.s !== null)
        .sort((a, b) => (a.s! - b.s!) || a.order - b.order)
        .slice(0, MAX);

      items.forEach((li) => (li.hidden = true));
      ranked.forEach((r, i) => {
        r.li.hidden = false;
        r.li.style.order = String(i);
      });
      visible = ranked.map((r) => r.li.querySelector('a')!);
      empty.hidden = visible.length > 0;
      results.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setActive(visible.length ? 0 : -1);
      status.textContent = visible.length
        ? `${visible.length} matching service${visible.length === 1 ? '' : 's'}`
        : 'No matching services';
    };

    const open = () => {
      document.dispatchEvent(new CustomEvent('sedco:search-open'));
      root.setAttribute('data-open', '');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close search');
      requestAnimationFrame(() => input.focus());
    };

    const shut = (returnFocus = false) => {
      root.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Search services');
      input.value = '';
      update();
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => (isOpen() ? shut() : open()));
    input.addEventListener('input', update);

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' && visible.length) {
        event.preventDefault();
        setActive((active + 1) % visible.length);
      } else if (event.key === 'ArrowUp' && visible.length) {
        event.preventDefault();
        setActive((active - 1 + visible.length) % visible.length);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const target = visible[Math.max(active, 0)];
        if (target) window.location.href = target.href;
      } else if (event.key === 'Escape') {
        event.preventDefault();
        shut(true);
      }
    });

    // Example searches fill the box.
    root.querySelectorAll<HTMLButtonElement>('[data-search-example]').forEach((button) =>
      button.addEventListener('click', () => {
        input.value = button.dataset.searchExample ?? '';
        update();
        input.focus();
      }),
    );

    // Hovering a result makes it the active one.
    items.forEach((li) =>
      li.querySelector('a')!.addEventListener('mousemove', (event) => {
        const index = visible.indexOf(event.currentTarget as HTMLAnchorElement);
        if (index !== active && index >= 0) setActive(index);
      }),
    );

    // Close on outside click, or when a header menu opens.
    document.addEventListener('click', (event) => {
      if (isOpen() && !root.contains(event.target as Node)) shut();
    });
    document.addEventListener('sedco:menu-open', () => {
      if (isOpen()) shut();
    });
  }
</script>
