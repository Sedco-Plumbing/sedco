---
/**
 * Sticky action bar on phones (≤ 768px): Call (yellow) and Request Service
 * (deep navy, yellow text) side by side, always at the bottom of the screen.
 * Request Service opens the slide-in request form (RequestDrawer); without JS
 * it falls through to the contact page form. The layout pads the page by the
 * bar's height so it never covers the footer.
 */
import { paths } from '@config/site';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
---

<div class="action-bar">
  <a class="action-bar__call" href={phoneHref()}>
    <Icon name="phone" size={20} />
    Call Now
  </a>
  <a class="action-bar__request" href={`${paths.contact}#request`} data-open-request>
    <Icon name="free-estimate" size={20} />
    Request Service
  </a>
</div>

<style>
  .action-bar {
    display: none;
  }

  @media (max-width: 768px) {
    .action-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 35;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
      background: var(--white);
      box-shadow: 0 -8px 24px rgba(11, 37, 69, 0.16);
    }

    .action-bar a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 52px;
      border-radius: var(--r-md);
      font-size: 17px;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .action-bar__call {
      background: var(--yellow-500);
      color: var(--navy-800);
    }

    .action-bar__call:active {
      background: var(--yellow-700);
    }

    .action-bar__request {
      background: var(--navy-800);
      color: var(--yellow-500);
    }

    .action-bar__request:hover,
    .action-bar__request:active {
      background: var(--navy-700);
      color: var(--yellow-500);
    }

    .action-bar a:focus-visible {
      outline-offset: 2px;
    }

    :global(body) {
      padding-bottom: calc(68px + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 380px) {
    .action-bar a {
      gap: 6px;
      font-size: 15.5px;
    }
  }
</style>
