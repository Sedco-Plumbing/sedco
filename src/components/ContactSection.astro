---
/**
 * "Talk to a Plumber" contact section at the foot of most pages.
 * Desktop: navy rounded panel, intro + call card + hours on the left, the
 * request form card on the right. Mobile: light panel with a large Call
 * button and a Request Service button that opens the slide-in form (the
 * inline form is hidden on phones), plus an urgent-leak note.
 *
 * (The no-JS target of "Request Service" links is the Contact page form.)
 */
import { site, paths } from '@config/site';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
import RequestForm from './RequestForm.astro';

interface Props {
  heading?: string;
  /** Intro paragraph; the phone number is linked automatically */
  intro?: string;
  /** Pre-selected service name (catalog name) */
  service?: string;
  /** Title of the form card */
  formTitle?: string;
  id?: string;
}

const {
  heading = 'Talk to a Plumber in El Cajon Today',
  intro = "The quickest way to reach us is to call {phone}, and someone will pick up at any hour from Monday to Saturday. If you'd rather write, send us a short request and we'll call you back within 30 minutes to talk about the problem and arrange a visit.",
  service,
  formTitle = 'Request Service',
  id = 'request',
} = Astro.props;

const phone = site.business.phone;
const tel = phoneHref();
const [introBefore, introAfter = ''] = intro.split('{phone}');
const headingId = `${id}-heading`;
---

<section class="contact" id={id} aria-labelledby={headingId}>
  <div class="contact__panel">
    <div class="contact__grid">
      <div class="contact__intro">
        <h2 class="contact__title" id={headingId}>{heading}</h2>
        <p class="contact__text">
          {introBefore}{intro.includes('{phone}') && <a href={tel}>{phone}</a>}{introAfter}
        </p>

        <a class="call-card" href={tel}>
          <span class="call-card__icon"><Icon name="phone" size={26} /></span>
          <span>
            <span class="call-card__label">Call now, we pick up 24/6</span>
            <span class="call-card__number">{phone}</span>
          </span>
        </a>
        <a class="call-mobile" href={tel}><Icon name="phone" size={26} />Call {phone}</a>
        <a class="request-mobile" href={`${paths.contact}#request`} data-open-request data-service={service}>
          <Icon name="free-estimate" size={22} />Request Service
        </a>
        <div class="urgent-mobile" role="note">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
          <p>If water is leaking or backing up right now, please call us instead of using the form, so that we can help you straight away.</p>
        </div>

        <ul class="contact__facts">
          <li><Icon name="clock" size={20} />{site.business.hours}</li>
          <li>
            <Icon name="map-pin" size={20} />
            <span>{site.business.name} · {site.business.locality}, {site.business.region} · <a href={tel}>{phone}</a></span>
          </li>
        </ul>
      </div>

      <div class="form-card">
        <div class="form-card__head">
          <div>
            <p class="form-card__title">{formTitle}</p>
            <p class="form-card__lead">We'll call you back within 30 minutes, Monday to Saturday.</p>
          </div>
          <div class="chip-row form-card__chips">
            <span class="chip"><Icon name="check" size={16} strokeWidth={2.75} />Free Estimates</span>
            <span class="chip"><Icon name="check" size={16} strokeWidth={2.75} />No Trip Charge</span>
          </div>
        </div>
        <RequestForm id={`${id}-form`} source="contact-section" service={service} />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 64px var(--section-inset) 72px;
  }

  .contact__panel {
    padding: 80px clamp(24px, 6vw, 105px);
    border-radius: var(--r-section);
    background: var(--navy-800);
    color: var(--white);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    align-items: center;
    max-width: var(--container);
    margin: 0 auto;
  }

  .contact__title {
    font-weight: 800;
    font-size: 44px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .contact__text {
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--blue-200);
  }

  .contact__text a {
    color: var(--white);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .contact__text a:hover {
    color: var(--blue-300);
  }

  .call-card {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 32px;
    padding: 18px 22px;
    border-radius: 18px;
    background: var(--yellow-500);
    color: var(--navy-800);
    text-decoration: none;
    transition:
      transform var(--t-base) var(--ease-out),
      background-color var(--t-base) ease;
  }

  .call-card:hover {
    background: var(--yellow-400);
    color: var(--navy-800);
    transform: scale(1.02);
  }

  .call-card:active {
    background: var(--yellow-600);
    transform: scale(0.99);
  }

  .call-card:focus-visible {
    outline-color: var(--white);
    outline-offset: 3px;
  }

  .call-card__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .call-card__label {
    display: block;
    font-size: 15px;
    font-weight: 600;
  }

  .call-card__number {
    display: block;
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .call-mobile,
  .request-mobile,
  .urgent-mobile {
    display: none;
  }

  .contact__facts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--navy-600);
    list-style: none;
    font-size: 16px;
    color: var(--blue-100);
  }

  .contact__facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .contact__facts :global(svg) {
    flex: none;
    color: var(--blue-300);
  }

  .contact__facts a {
    color: var(--white);
  }

  .contact__facts a:hover {
    color: var(--blue-300);
  }

  .form-card {
    padding: 40px;
    border-radius: var(--r-2xl);
    background: var(--white);
    box-shadow: var(--shadow-form);
    color: var(--ink);
  }

  .form-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--slate-200);
  }

  .form-card__title {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 38px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--navy-800);
  }

  .form-card__lead {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--slate-600);
  }

  .form-card__chips {
    flex: none;
    margin-top: 4px;
  }

  @media (max-width: 1199px) {
    .contact__grid {
      gap: 48px;
    }

    .form-card {
      padding: 32px;
    }
  }

  @media (max-width: 959px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- mobile: light panel (390px artboard) ---- */
  @media (max-width: 768px) {
    .contact {
      padding: 0;
    }

    .contact__panel {
      padding: 44px 16px;
      border-radius: 0;
      background: var(--sky-50);
      color: var(--ink);
    }

    .contact__grid {
      gap: 28px;
    }

    .contact__intro {
      padding: 0 8px;
    }

    .contact__title {
      font-size: 28px;
      line-height: 1.2;
      color: var(--navy-800);
    }

    .contact__text {
      margin-top: 16px;
      font-size: 17px;
      color: var(--slate-600);
    }

    .contact__text a {
      color: var(--blue-600);
      text-decoration: none;
    }

    .call-card {
      display: none;
    }

    .call-mobile {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      height: 76px;
      margin: 24px -8px 0;
      border-radius: var(--r-lg);
      background: var(--yellow-500);
      font-family: var(--font-title);
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--navy-800);
      text-decoration: none;
    }

    .call-mobile:active {
      background: var(--yellow-700);
    }

    .request-mobile {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      height: 60px;
      margin: 10px -8px 0;
      border-radius: var(--r-lg);
      background: var(--navy-800);
      font-size: 19px;
      font-weight: 700;
      color: var(--yellow-500);
      text-decoration: none;
    }

    .request-mobile:active {
      background: var(--navy-700);
      color: var(--yellow-500);
    }

    .urgent-mobile {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      margin: 16px -8px 0;
      padding: 16px 18px;
      border-left: 4px solid var(--yellow-500);
      border-radius: var(--r-md);
      background: var(--yellow-100);
      color: var(--navy-800);
    }

    .urgent-mobile svg {
      flex: none;
      margin-top: 2px;
    }

    .urgent-mobile p {
      font-size: 16px;
      line-height: 1.55;
      font-weight: 500;
    }

    .contact__facts {
      gap: 8px;
      margin-top: 16px;
      padding-top: 0;
      border-top: 0;
      color: var(--ink);
    }

    .contact__facts li {
      align-items: flex-start;
      line-height: 1.5;
    }

    .contact__facts :global(svg) {
      margin-top: 1px;
      color: var(--blue-600);
    }

    .contact__facts a {
      color: var(--blue-600);
    }

    /* On phones the form opens in the slide-in drawer instead. */
    .form-card {
      display: none;
    }
  }
</style>
