---
/**
 * Contact section at the foot of most pages, built like the Contact page: a
 * navy band with the section heading, intro and three quick facts, and the
 * ContactDesk panel (request form + navy contact details) overlapping it.
 *
 * Heading and intro come from each page (the SEO copy's CTA block). On phones
 * the desk shows a Request Service button that opens the slide-in form instead
 * of the inline form. (The no-JS target of "Request Service" links is the
 * Contact page form.)
 */
import { site } from '@config/site';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
import ContactDesk from './ContactDesk.astro';

interface Props {
  heading?: string;
  /** Intro paragraph; the phone number is linked automatically */
  intro?: string;
  /** Pre-selected service name (catalog name) */
  service?: string;
  /** Pre-selected town (city name) */
  city?: string;
  /** Title of the form column */
  formTitle?: string;
  id?: string;
}

const {
  heading = 'Talk to a Plumber in El Cajon Today',
  intro = "The quickest way to reach us is to call {phone}, and someone will pick up at any hour from Monday to Saturday. If you'd rather write, send us a short request and we'll call you back within 30 minutes to talk about the problem and arrange a visit.",
  service,
  city,
  formTitle,
  id = 'request',
} = Astro.props;

const phone = site.business.phone;
const tel = phoneHref();
const [introBefore, introAfter = ''] = intro.split('{phone}');
const headingId = `${id}-heading`;
---

<section class="contact" id={id} aria-labelledby={headingId}>
  <div class="contact__band on-navy">
    <div class="contact__head">
      <p class="contact__eyebrow">Contact us</p>
      <h2 class="contact__title" id={headingId}>{heading}</h2>
      <p class="contact__text">
        {introBefore}{intro.includes('{phone}') && <a href={tel}>{phone}</a>}{introAfter}
      </p>
      <ul class="contact__facts">
        <li><Icon name="phone" size={20} /><strong>Call any hour, Mon–Sat</strong></li>
        <li><Icon name="clock" size={20} /><strong>30-minute callback</strong></li>
        <li><Icon name="free-estimate" size={20} /><strong>Free estimate, no trip charge</strong></li>
      </ul>
    </div>
  </div>

  <div class="contact__desk">
    <ContactDesk id={id} source="contact-section" service={service} city={city} title={formTitle} headingLevel="h3" />
  </div>
</section>

<style>
  .contact {
    padding: 64px 0 80px;
  }

  .contact__band {
    margin: 0 var(--section-inset);
    padding: 80px var(--gutter) 184px;
    border-radius: var(--r-section);
    background:
      radial-gradient(60% 90% at 100% 0%, rgba(55, 133, 201, 0.3) 0%, rgba(11, 37, 69, 0) 65%),
      var(--navy-800);
    color: var(--blue-200);
  }

  .contact__head {
    max-width: var(--container);
    margin: 0 auto;
  }

  .contact__eyebrow {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow-500);
  }

  .contact__title {
    max-width: 820px;
    margin-top: 12px;
    font-weight: 800;
    font-size: 44px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .contact__text {
    max-width: 760px;
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--blue-200);
  }

  .contact__text a {
    font-weight: 600;
    color: var(--white);
    text-underline-offset: 3px;
  }

  .contact__text a:hover {
    color: var(--yellow-500);
  }

  .contact__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin-top: 28px;
    list-style: none;
  }

  .contact__facts li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }

  .contact__facts :global(svg) {
    flex: none;
    color: var(--yellow-500);
  }

  .contact__facts strong {
    font-weight: 600;
    color: var(--white);
  }

  .contact__desk {
    position: relative;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: -128px auto 0;
    padding: 0 var(--gutter);
  }

  @media (max-width: 768px) {
    .contact {
      padding: 40px 0 48px;
    }

    .contact__band {
      padding: 40px 20px 120px;
      border-radius: var(--r-2xl);
    }

    .contact__eyebrow {
      font-size: 13px;
    }

    .contact__title {
      font-size: 30px;
      line-height: 1.15;
    }

    .contact__text {
      margin-top: 14px;
      font-size: 17px;
    }

    .contact__facts {
      flex-direction: column;
      gap: 10px;
      margin-top: 22px;
    }

    .contact__desk {
      margin-top: -88px;
      padding: 0 var(--section-inset);
    }
  }
</style>
