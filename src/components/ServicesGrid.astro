---
/**
 * The services grid: the four design groups, each with its service cards
 * (illustration, name, summary, Free estimate / No trip charge, rating, and
 * Get a Free Estimate + Call). Used on the homepage (with its own H2) and on
 * /services/ (under the page H1, so groups become H2s and cards H3s).
 *
 * Every card links to the service's live URL (keyword map). The rating line
 * shows the confirmed "5.0 on Google"; the design's per-service "clients
 * served" counts were placeholders and are deliberately not shown.
 */
import { site, paths } from '@config/site';
import { catalogGroups, serviceHref } from '@config/catalog';
import { phoneHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';
import ResponsiveImage from '@components/ui/ResponsiveImage.astro';
import Stars from '@components/ui/Stars.astro';

interface Props {
  /** Section H2; omit on /services/ where the page H1 introduces the grid */
  heading?: string;
  intro?: string;
  /** Homepage: keep the heading clear of the hero estimate card that overlaps this section */
  formGap?: boolean;
  id?: string;
}

const { heading, intro, formGap = false, id = 'services' } = Astro.props;
const GroupTag = heading ? 'h3' : 'h2';
const CardTag = heading ? 'h4' : 'h3';
const tel = phoneHref();
---

<section class="services" id={id} aria-labelledby={heading ? `${id}-heading` : undefined} aria-label={heading ? undefined : 'Our plumbing services'}>
  <div class="container">
    {
      heading && (
        <div class:list={['services__head', formGap && 'services__head--gap']}>
          <p class="eyebrow">Services</p>
          <h2 class="services__title" id={`${id}-heading`}>{heading}</h2>
          {intro && <p class="services__intro">{intro}</p>}
        </div>
      )
    }

    <div class:list={['services__groups', !heading && 'services__groups--flush']}>
      {
        catalogGroups.map((group) => (
          <section class="group" id={`group-${group.key}`} aria-labelledby={`${id}-${group.key}`}>
            <div class="group__head">
              <span class="group__icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={group.iconPath} />
                </svg>
              </span>
              <GroupTag class="group__title" id={`${id}-${group.key}`}>{group.title}</GroupTag>
              <span class="group__rule" aria-hidden="true" />
            </div>

            <ul class="cards">
              {group.services.map((service) => (
                <li class="card">
                  <div class="card__media">
                    <ResponsiveImage name={service.image} alt="" sizes="172px" class="card__img" />
                  </div>
                  <div class="card__body">
                    <CardTag class="card__title">
                      <a href={serviceHref(service)}>{service.name}</a>
                    </CardTag>
                    <p class="card__summary">{service.summary}</p>
                    <div class="card__perks">
                      <span><span class="card__tick" aria-hidden="true"><Icon name="check" size={12} strokeWidth={3.5} /></span>Free estimate</span>
                      <span class="card__divider" aria-hidden="true" />
                      <span><span class="card__tick" aria-hidden="true"><Icon name="check" size={12} strokeWidth={3.5} /></span>No trip charge</span>
                    </div>
                    <div class="card__rating">
                      <Stars size={16} label="Rated 5 out of 5" />
                      <span><strong>5.0</strong> on Google</span>
                    </div>
                    <div class="card__actions">
                      <a
                        class="card__estimate"
                        href={`${paths.contact}#request`}
                        data-open-request
                        data-service={service.name}
                      >
                        Get a Free Estimate<Icon name="arrow-right" size={18} strokeWidth={2.5} />
                      </a>
                      <a class="card__call" href={tel} aria-label={`Call ${site.business.phone}`} title={site.business.phone}>
                        <Icon name="phone" size={20} />
                      </a>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: 64px 0;
  }

  .services__head {
    max-width: 820px;
  }

  /* The hero estimate card hangs 520px into this section on wide screens. */
  .services__head--gap {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 540px;
    min-height: 520px;
  }

  .services__title {
    margin-top: 12px;
    font-weight: 800;
    font-size: 52px;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .services__intro {
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--slate-600);
  }

  .services__groups {
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin-top: 64px;
  }

  .services__groups--flush {
    margin-top: 0;
  }

  .group__head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .group__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-lg);
    background: var(--navy-800);
    box-shadow: inset 0 -3px 0 var(--yellow-500);
    color: var(--white);
  }

  .group__title {
    flex: none;
    font-weight: 800;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .group__rule {
    flex: 1 1 0;
    min-width: 0;
    height: 1px;
    margin-left: 4px;
    background: linear-gradient(90deg, #c9d6e5, rgba(201, 214, 229, 0));
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
    list-style: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 4px;
    padding: 10px;
    border-radius: 28px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgba(11, 37, 69, 0.05),
      0 12px 32px rgba(11, 37, 69, 0.07);
    transition:
      transform 240ms var(--ease-out),
      box-shadow 240ms ease;
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 2px 4px rgba(11, 37, 69, 0.05),
      0 30px 60px rgba(11, 37, 69, 0.14);
  }

  .card__media {
    position: relative;
    height: 172px;
    border-radius: var(--r-xl);
    background-color: var(--navy-800);
    background-image:
      radial-gradient(70% 90% at 50% 100%, rgba(31, 92, 150, 0.95) 0%, rgba(11, 37, 69, 0) 72%),
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size:
      100% 100%,
      22px 22px,
      22px 22px;
    background-position:
      center,
      -1px -1px,
      -1px -1px;
  }

  .card__media :global(.card__img) {
    position: absolute;
    left: 50%;
    bottom: -46px;
    width: 172px;
    height: 172px;
    object-fit: contain;
    transform: translateX(-50%);
    filter: drop-shadow(0 20px 22px rgba(11, 37, 69, 0.35));
  }

  .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 62px 14px 12px;
    text-align: center;
  }

  .card__title {
    font-weight: 800;
    font-size: 26px;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .card__title a {
    color: var(--navy-800);
    text-decoration: none;
    border-radius: 4px;
  }

  .card__title a:hover {
    color: var(--blue-700);
  }

  .card__title a:focus-visible {
    outline-offset: 4px;
  }

  /* The whole card is clickable through the title link. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
  }

  .card__summary {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--slate-600);
  }

  .card__perks {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .card__perks > span:not(.card__divider) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-800);
    white-space: nowrap;
  }

  .card__tick {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--yellow-500);
    box-shadow: 0 0 0 3px #fff1cc;
    color: var(--navy-800);
  }

  .card__divider {
    width: 1px;
    height: 18px;
    background: var(--slate-200);
  }

  .card__rating {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 10px;
    margin-top: 14px;
    font-size: 14px;
    color: var(--slate-600);
  }

  .card__rating strong {
    font-weight: 700;
    color: var(--navy-800);
  }

  .card__actions {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-top: auto;
    padding-top: 20px;
  }

  .card__estimate {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 52px;
    padding: 0 18px;
    border-radius: var(--r-md);
    background: var(--yellow-500);
    font-size: 16px;
    font-weight: 700;
    color: var(--navy-800);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }

  .card__estimate:hover {
    background: var(--yellow-400);
    color: var(--navy-800);
    transform: translateY(-1px);
  }

  .card__estimate:active {
    background: var(--yellow-600);
    transform: none;
  }

  .card__call {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--r-md);
    background: var(--navy-800);
    color: var(--yellow-500);
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }

  .card__call:hover {
    background: var(--navy-600);
    color: var(--yellow-500);
    transform: translateY(-1px);
  }

  .card__estimate:focus-visible,
  .card__call:focus-visible {
    outline-offset: 3px;
  }

  @media (max-width: 1199px) {
    .services__title {
      font-size: 44px;
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .group__title {
      flex: 0 1 auto;
      min-width: 0;
      white-space: normal;
    }
  }

  /* The estimate card stops overlapping once the hero stacks. */
  @media (max-width: 959px) {
    .services__head--gap {
      max-width: 820px;
      min-height: 0;
    }
  }

  @media (max-width: 768px) {
    .services {
      padding: 40px 0;
    }

    .services__title {
      font-size: 30px;
      line-height: 1.1;
    }

    .services__intro {
      font-size: 17px;
    }

    .services__groups {
      gap: 56px;
      margin-top: 44px;
    }

    .group__title {
      font-size: 24px;
    }

    .cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .card__title {
      font-size: 24px;
    }
  }
</style>
