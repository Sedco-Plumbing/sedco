---
/**
 * Inline SVG icon from the Sedco icon set (src/lib/icons.ts). Inlined at build
 * time, so icons cost no requests. Decorative by default (aria-hidden); pass
 * `label` when the icon carries meaning on its own.
 */
import { icons, type IconName } from '@lib/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, label, class: className, strokeWidth } = Astro.props;
const icon = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={strokeWidth ?? icon.stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={icon.d}></path>
</svg>
