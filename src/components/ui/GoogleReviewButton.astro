---
/**
 * "Leave a Google review" button: opens the Google Business Profile in a new
 * tab. Renders nothing until the review link is set (Keystatic → Business
 * details → Google review link).
 *
 *   variant="solid"   white button with the Google "G", for light or navy panels
 *   variant="text"    inline text link, for tight spots like the rating row
 */
import { googleReviewHref } from '@lib/tokens';
import Icon from '@components/ui/Icon.astro';

interface Props {
  variant?: 'solid' | 'text';
  label?: string;
  class?: string;
}

const { variant = 'solid', label = 'Leave a Google review', class: className } = Astro.props;
const href = googleReviewHref();
---

{
  href && (
    <a
      class:list={['greview', `greview--${variant}`, className]}
      href={href}
      target="_blank"
      rel="noopener"
      data-review-link
    >
      {variant === 'solid' && (
        <svg class="greview__g" viewBox="0 0 48 48" width="22" height="22" aria-hidden="true" focusable="false">
          <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z" />
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
          <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
        </svg>
      )}
      <span>{label}</span>
      <Icon name="arrow-up-right" size={variant === 'solid' ? 18 : 16} class="greview__arrow" />
      <span class="visually-hidden">(opens in a new tab)</span>
    </a>
  )
}

<style>
  .greview {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .greview--solid {
    gap: 10px;
    height: 52px;
    padding: 0 20px 0 16px;
    border: 1.5px solid var(--slate-200);
    border-radius: var(--r-md);
    background: var(--white);
    box-shadow: 0 6px 16px rgba(11, 37, 69, 0.08);
    font: 600 16px/1 var(--font-body);
    color: var(--navy-800);
    transition:
      border-color var(--t-fast) ease,
      box-shadow var(--t-fast) ease,
      transform var(--t-base) var(--ease-out);
  }

  .greview--solid:hover {
    border-color: var(--navy-800);
    box-shadow: 0 10px 24px rgba(11, 37, 69, 0.14);
    transform: translateY(-1px);
  }

  .greview__g {
    flex: none;
  }

  .greview--solid :global(.greview__arrow) {
    color: var(--slate-500);
  }

  .greview--text {
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    color: var(--blue-600);
  }

  .greview--text:hover {
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .greview:focus-visible {
    outline: 3px solid var(--blue-600);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .greview--solid:hover {
      transform: none;
    }
  }
</style>
