---
/**
 * Site footer: brand + summary, contact (NAP), the design's seven services,
 * all ten service-area towns, and the licence / blog / privacy row.
 * The business name, city and phone match the header, schema and contact
 * section exactly (consistent NAP).
 */
import { site, paths } from '@config/site';
import { footerServices, serviceHref } from '@config/catalog';
import { phoneHref } from '@lib/tokens';

const phone = site.business.phone;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href={paths.home} aria-label={`${site.business.name} home`}>
          <img src="/images/brand/sedco-plumbing-logo-84w.webp" alt="" width="48" height="48" loading="lazy" />
          <span>{site.business.name}</span>
        </a>
        <p class="footer__about">
          {site.business.name} is a licensed {site.business.locality} plumbing company serving homes,
          rentals and businesses across {site.business.county}, and we're open 24 hours from Monday to
          Saturday.
        </p>
      </div>

      <div>
        <p class="footer__heading">Contact</p>
        <a class="footer__phone" href={phoneHref()}>{phone}</a>
        <p class="footer__text">{site.business.hours}</p>
        <p class="footer__text">{site.business.name} · {site.business.locality}, {site.business.region}</p>
      </div>

      <nav aria-label="Services">
        <p class="footer__heading">Services</p>
        <ul class="footer__links">
          {
            footerServices.map((service) => (
              <li>
                <a href={serviceHref(service)}>{service.name}</a>
              </li>
            ))
          }
          <li><a href={paths.servicesHub}>All services</a></li>
        </ul>
      </nav>

      <nav aria-label="Service areas">
        <p class="footer__heading">Service Areas</p>
        <ul class="footer__links footer__links--towns">
          {
            site.cities.map((city) => (
              <li>
                <a href={paths.city(city.slug)}>{city.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <span>Licensed CA {site.business.licenseClass} · © {year} {site.business.name}</span>
      <nav class="footer__legal" aria-label="More">
        <a href={paths.about}>About</a>
        <a href={paths.reviews}>Reviews</a>
        <a href={paths.blog}>Blog</a>
        <a href={paths.privacy}>Privacy policy</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 64px var(--gutter) 32px;
    background: var(--navy-800);
    color: var(--blue-100);
  }

  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 3fr) minmax(0, 3fr);
    gap: 48px;
  }

  .footer a:focus-visible {
    outline-color: var(--blue-300);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border-radius: var(--r-sm);
    color: var(--white);
    text-decoration: none;
  }

  .footer__logo:hover {
    color: var(--white);
  }

  .footer__logo img {
    width: 48px;
    height: 48px;
    border-radius: var(--r-sm);
  }

  .footer__logo span {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .footer__about {
    margin-top: 20px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--blue-200);
  }

  .footer__heading {
    margin-bottom: 16px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue-300);
  }

  .footer__phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-title);
    font-size: 24px;
    font-weight: 800;
    color: var(--white);
    text-decoration: none;
  }

  .footer__phone:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .footer__text {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--blue-200);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  .footer__links--towns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 4px 0;
    font-size: 16px;
    line-height: 1.25;
    color: var(--blue-100);
    text-decoration: none;
  }

  .footer__links a:hover,
  .footer__legal a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--navy-600);
    font-size: 15px;
    color: var(--blue-200);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--blue-100);
  }

  @media (max-width: 1199px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding: 56px 24px 40px;
    }

    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .footer__logo img {
      width: 44px;
      height: 44px;
    }

    .footer__logo span {
      font-size: 20px;
    }

    .footer__about {
      margin-top: 16px;
    }

    .footer__heading {
      margin-bottom: 8px;
      font-size: 14px;
    }

    .footer__text {
      margin-top: 4px;
    }

    .footer__links a {
      min-height: 44px;
    }

    .footer__bottom {
      margin-top: 32px;
      padding-top: 20px;
    }
  }
</style>
