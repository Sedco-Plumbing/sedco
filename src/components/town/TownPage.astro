---
/**
 * TOWN PAGE TEMPLATE — /service-areas/[town]/, in the 2026 design language
 * (the handoff specifies the Service Areas page as its template).
 *
 * Hero (with the typical drive time and nearby-town pills) → two-column body:
 * the page's SEO copy verbatim (intro → Overview, then each section), the
 * services available in the town, reviews, FAQ and the "Also serving nearby"
 * line; sticky aside with call card and "On this page" → contact section.
 */
import type { CollectionEntry } from 'astro:content';
import { site, paths, getCity, type CityDef } from '@config/site';
import { t } from '@lib/tokens';
import type { Crumb, TocItem } from '@lib/types';
import PageHero from '@components/PageHero.astro';
import CopySection from '@components/service/CopySection.astro';
import ServiceAside from '@components/service/ServiceAside.astro';
import ServiceReviews from '@components/service/ServiceReviews.astro';
import TownServices from './TownServices.astro';
import Faq from '@components/Faq.astro';
import ContactSection from '@components/ContactSection.astro';
import Icon from '@components/ui/Icon.astro';
import { phoneHref } from '@lib/tokens';

interface Props {
  data: CollectionEntry<'serviceAreas'>['data'];
  city: CityDef;
  crumbs: Crumb[];
}

const { data, city, crumbs } = Astro.props;

const slugify = (text: string) =>
  t(text)
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const sections = data.sections.map((section) => ({ id: slugify(section.heading), section }));
const nearby = city.nearby.map(getCity);
const faqHeading =
  data.faqHeading && data.faqHeading !== 'Frequently Asked Questions'
    ? data.faqHeading
    : `Plumbing Questions From ${city.name}`;

const toc: TocItem[] = [
  { id: 'overview', label: 'Overview' },
  ...sections.map(({ id, section }) => ({ id, label: section.tocLabel ?? t(section.heading) })),
  { id: 'services', label: `${city.name} plumbing services` },
  { id: 'reviews', label: 'Reviews' },
  ...(data.faqs.length > 0 ? [{ id: 'questions', label: 'Questions' }] : []),
];

const moreLinks = data.internalLinks.filter((link) => !link.href.startsWith(paths.city(city.slug)));
const asideHeading = `Need a plumber in ${city.name}?`;
const asideText = 'Same-day visits, a free estimate and no trip charge.';
---

<PageHero
  crumbs={crumbs}
  eyebrow={data.heroBadge ?? `Serving ${city.name}, CA`}
  heading={t(data.h1)}
  intro={`Local, licensed plumbers for ${city.name} homes, rentals and businesses — ${city.descriptor}. Free estimate, no trip charge.`}
>
  <div class="town-hero-below" slot="below">
    {
      data.heroStat && (
        <p class="town-stat">
          <Icon name="clock" size={18} />
          <strong>{data.heroStat}</strong>{data.heroStatLabel && ` · ${data.heroStatLabel}`}
        </p>
      )
    }
    {
      nearby.length > 0 && (
        <ul class="nearby-pills" aria-label="Nearby towns we serve">
          {nearby.map((town) => (
            <li>
              <a href={paths.city(town.slug)}>
                <Icon name="map-pin" size={14} />
                {town.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</PageHero>

<div class="town-body">
  <div class="town-body__grid">
    <article class="town-article">
      <CopySection id="overview" lead section={{ heading: `Your Local Plumber in ${city.name}`, paragraphs: data.intro }} />

      <div class="inline-call on-navy">
        <p class="inline-call__title">{asideHeading}</p>
        <p class="inline-call__text">{asideText}</p>
        <a class="btn btn--call btn--block" href={phoneHref()}><Icon name="phone" size={20} />Call {site.business.phone}</a>
      </div>

      {sections.map(({ id, section }) => <CopySection id={id} section={section} />)}

      <TownServices id="services" city={city} services={site.services} />

      <div class="article-section">
        <ServiceReviews id="reviews" match={[]} />
      </div>

      {
        data.faqs.length > 0 && (
          <div class="article-section">
            <Faq faqs={data.faqs} heading={faqHeading} variant="column" id="questions" mobileCall />
          </div>
        )
      }

      <div class="article-section town-links">
        {
          data.alsoServing && nearby.length > 0 && (
            <p class="also-serving">
              Also serving nearby:{' '}
              {nearby.map((town, index) => (
                <>
                  <a href={paths.city(town.slug)}>{town.name}</a>
                  {index < nearby.length - 2 ? ', ' : index === nearby.length - 2 ? ', and ' : ''}
                </>
              ))}
              {city.nearbyNote ? ` — including ${city.nearbyNote}.` : '.'}
            </p>
          )
        }
        {
          moreLinks.length > 0 && (
            <nav class="more-links" aria-label="More from Sedco Plumbing">
              <ul>
                {moreLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.anchor}
                      <Icon name="arrow-right" size={15} />
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </article>

    <ServiceAside heading={asideHeading} text={asideText} toc={toc} />
  </div>
</div>

<ContactSection heading={t(data.ctaHeading)} intro={t(data.ctaBody)} city={city.name} />

<style>
  .town-hero-below {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }

  .town-stat {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--blue-200);
  }

  .town-stat strong {
    font-weight: 700;
    color: var(--white);
  }

  .town-stat :global(svg) {
    color: var(--yellow-500);
  }

  .nearby-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .nearby-pills a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 14px;
    border: 1.5px solid var(--blue-400);
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
  }

  .nearby-pills a:hover {
    border-color: var(--yellow-500);
    background: var(--yellow-500);
    color: var(--navy-800);
  }

  .town-body {
    padding: 88px var(--gutter) 40px;
  }

  .town-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 72px;
    align-items: start;
    max-width: var(--container);
    margin: 0 auto;
  }

  .town-article {
    min-width: 0;
  }

  .also-serving {
    font-size: 17px;
    line-height: 1.7;
    color: var(--slate-700);
  }

  .also-serving a {
    font-weight: 600;
  }

  .more-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
    list-style: none;
  }

  .more-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--blue-200);
    border-radius: var(--r-pill);
    background: var(--white);
    font-size: 15px;
    font-weight: 600;
    color: var(--blue-700);
    text-decoration: none;
  }

  .more-links a:hover {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .inline-call {
    display: none;
  }

  @media (max-width: 1099px) {
    .town-body__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .inline-call {
      display: block;
      margin-top: 32px;
      padding: 24px;
      border-radius: var(--r-xl);
      background: var(--navy-800);
    }

    .inline-call__title {
      font-family: var(--font-title);
      font-weight: 800;
      font-size: 22px;
      color: var(--white);
    }

    .inline-call__text {
      margin: 6px 0 18px;
      font-size: 15px;
      color: var(--blue-200);
    }
  }

  @media (max-width: 768px) {
    .town-body {
      padding: 44px 24px 8px;
    }

    .also-serving {
      font-size: 16px;
    }
  }
</style>
