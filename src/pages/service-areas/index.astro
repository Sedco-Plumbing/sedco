---
/**
 * SERVICE AREAS HUB — design "Sedco Service Areas".
 * Hero with the ten town pills → "Towns We Serve" grid → service-area map →
 * FAQ → contact. Every town links to its /service-areas/[town]/ page.
 */
import { site, paths } from '@config/site';
import { commonFaqs } from '@config/faqs';
import { PAGE_HERO_SIZES } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ServiceAreasSection from '@components/ServiceAreasSection.astro';
import Faq from '@components/Faq.astro';
import ContactSection from '@components/ContactSection.astro';
import Icon from '@components/ui/Icon.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Plumbing Service Areas in San Diego County | Sedco Plumbing';
const description =
  'Based in El Cajon, serving La Mesa, Santee, Lakeside, Spring Valley, Lemon Grove, Alpine, Rancho San Diego, Jamul and San Diego. Call [PHONE].';
const path = paths.areasHub;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Service Areas' }];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES }}
>
  <Fragment slot="head">
    <PageSchema type="CollectionPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    heading="Plumbing Service Areas Across San Diego County"
    intro="Sedco Plumbing is based in El Cajon, and our plumbers drive out to homes and businesses across San Diego County, with most of our work in the East County towns close to home. Every visit starts with a free estimate, with no trip charge."
  >
    <ul class="town-pills" slot="below" aria-label="Towns we serve">
      {
        site.cities.map((city) => (
          <li>
            <a href={paths.city(city.slug)}>{city.name}</a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section class="towns" aria-labelledby="towns-heading">
    <div class="container">
      <h2 class="towns__title" id="towns-heading">Towns We Serve</h2>
      <ul class="towns__grid">
        {
          site.cities.map((city) => (
            <li>
              <a class="towns__card" href={paths.city(city.slug)}>
                <Icon name="map-pin" size={22} />
                <span>{city.name}</span>
                <Icon name="arrow-right" size={18} class="towns__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ServiceAreasSection />

  <Faq faqs={commonFaqs} mobileCall />

  <ContactSection />
</BaseLayout>

<style>
  .town-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .town-pills a {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border: 1.5px solid var(--blue-400);
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      border-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .town-pills a:hover {
    border-color: var(--yellow-500);
    background: var(--yellow-500);
    color: var(--navy-800);
  }

  .town-pills a:focus-visible {
    outline-color: var(--blue-300);
  }

  .towns {
    padding: 72px 0 56px;
  }

  .towns__title {
    font-weight: 800;
    font-size: 36px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .towns__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
    list-style: none;
  }

  .towns__card {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    min-height: 64px;
    padding: 14px 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.25;
    color: var(--navy-800);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      border-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .towns__card span {
    flex: 1;
  }

  .towns__card:hover {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  @media (max-width: 1199px) {
    .towns__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .towns {
      padding: 44px 0 24px;
    }

    .towns__title {
      font-size: 28px;
    }

    .towns__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
