---
/**
 * TOWN PAGE — one per service-area town, from src/content/service-areas/*.yaml.
 *
 * Title, description, H1 and body copy come from the content entry (the SEO
 * team's copy, aligned with the keyword map); the layout is TownPage.
 *
 * Carries the Plumber entity with areaServed (same @id and areaServed list as
 * the homepage, so the entity is never published with conflicting data),
 * FAQPage, and BreadcrumbList through the layout.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { getCity, paths } from '@config/site';
import { PAGE_HERO_SIZES, HERO_PHOTO_MEDIA } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import TownPage from '@components/town/TownPage.astro';
import LocalBusinessSchema from '@components/schema/LocalBusinessSchema.astro';
import FaqSchema from '@components/schema/FaqSchema.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('serviceAreas');
  return entries.map((entry) => ({
    params: { city: entry.data.city },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const data = entry.data;
const city = getCity(data.city);
const path = paths.city(city.slug);

const crumbs = [
  { name: 'Home', href: paths.home },
  { name: 'Service Areas', href: paths.areasHub },
  { name: `${city.name}, CA` },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={path}
  crumbs={crumbs}
  drawerCity={city.name}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES, media: HERO_PHOTO_MEDIA }}
>
  <Fragment slot="head">
    <LocalBusinessSchema />
    {data.faqs.length > 0 && <FaqSchema faqs={data.faqs} />}
  </Fragment>

  <TownPage data={data} city={city} crumbs={crumbs} />
</BaseLayout>
