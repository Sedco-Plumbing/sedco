---
/**
 * ABOUT — design "Sedco About", carrying the page's SEO copy.
 * Hero → photo split (the founding paragraphs) → How We Work / Licensed /
 * Rooted in East County → What You Can Count On → reviews → service-area map
 * → contact (the page's own CTA heading and copy).
 */
import { paths } from '@config/site';
import { PAGE_HERO_SIZES, HERO_PHOTO_MEDIA } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import AboutSplit from '@components/AboutSplit.astro';
import CopySection from '@components/service/CopySection.astro';
import CountOn from '@components/CountOn.astro';
import ServiceReviews from '@components/service/ServiceReviews.astro';
import ServiceAreasSection from '@components/ServiceAreasSection.astro';
import ContactSection from '@components/ContactSection.astro';
import PageSchema from '@components/schema/PageSchema.astro';
import type { Section } from '@lib/types';

const title = 'About Sedco Plumbing | Locally Owned El Cajon Plumber';
const description =
  'Sedco Plumbing is a locally owned, licensed C-36 plumbing contractor in El Cajon serving East County and San Diego County homes and businesses.';
const path = paths.about;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'About' }];

const sections: Section[] = [
  {
    heading: 'How We Work',
    paragraphs: [
      'Every job starts with a conversation and a clear plan. We take the time to understand what’s happening, explain the available options, and provide straightforward pricing before work begins. Our technicians respect your home, keep the work area clean, and take care of the details throughout the job.',
      'We believe good plumbing service should be simple and stress-free. That’s why we focus on clear communication, dependable workmanship, and solutions that address the actual problem rather than unnecessary work.',
    ],
  },
  {
    heading: 'Licensed, Bonded, and Insured',
    paragraphs: [
      'When you invite a plumber into your home, you want to know you’re working with a qualified professional. Sedco Plumbing is a licensed, bonded, and insured California plumbing contractor committed to providing safe and dependable service.',
      'Our team follows applicable plumbing requirements and pays attention to the details that matter, from proper water heater installation to pressure regulation and other plumbing work throughout your home.',
      'You can feel confident knowing your plumbing project is being handled by a Licensed Plumber in El Cajon who takes your home and your investment seriously.',
    ],
  },
  {
    heading: 'Rooted in East County',
    paragraphs: [
      `We live and work where you do. Our team understands the homes and plumbing systems found throughout El Cajon, [La Mesa](${paths.city('la-mesa')}), [Santee](${paths.city('santee')}), and surrounding East County communities.`,
      'From older homes with aging plumbing to properties with mature trees that can affect underground sewer lines, local experience helps us identify potential problems more efficiently and recommend practical solutions. We’re proud to serve the community we call home and to build lasting relationships with local homeowners.',
      `Explore [every plumbing service we offer](${paths.servicesHub}), see our [plumbing work in El Cajon neighborhoods](${paths.city('el-cajon')}), or read [what your neighbors say about Sedco Plumbing](${paths.reviews}).`,
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES, media: HERO_PHOTO_MEDIA }}
>
  <Fragment slot="head">
    <PageSchema type="AboutPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    eyebrow="About Sedco Plumbing"
    heading="About Sedco Plumbing, a Locally Owned El Cajon Plumber"
    intro="Sedco Plumbing is a locally owned El Cajon plumber and a licensed C-36 plumbing contractor serving San Diego County. As an East County plumbing company, we know the older homes, hillside lots and water conditions in our area. About every job starts the same way: an honest look at the problem and an upfront price before any work begins."
  />

  <AboutSplit
    heading="An El Cajon Plumbing Company With 20 Years of Experience"
    paragraphs={[
      'Sedco Plumbing was founded with a simple idea: every home deserves a plumbing company it can rely on. Based in El Cajon, we provide straightforward plumbing service with a focus on honest communication, quality workmanship, and dependable solutions.',
      'Our team serves homeowners and businesses throughout East County and San Diego County. Whether you need help with a routine plumbing issue or a larger repair, we take the time to understand the problem, explain your options, and complete the work with care.',
    ]}
  />

  <div class="about-copy">
    <div class="about-copy__inner">
      {sections.map((section, index) => <CopySection id={`about-${index + 1}`} section={section} />)}
    </div>
  </div>

  <CountOn as="h2" standalone />

  <div class="about-reviews">
    <div class="about-reviews__inner">
      <ServiceReviews id="reviews" match={[]} />
    </div>
  </div>

  <ServiceAreasSection />

  <ContactSection
    heading="Ready When You Need Us"
    intro="Whether it’s a dripping faucet, a stubborn drain, a water heater problem, or a larger plumbing repair, we’re ready to help. Call Sedco Plumbing at {phone} or request service online to discuss your plumbing needs. We proudly serve homeowners and businesses throughout El Cajon and communities across San Diego County with straightforward service and dependable workmanship."
  />
</BaseLayout>

<style>
  .about-copy,
  .about-reviews {
    padding: 72px var(--gutter) 56px;
  }

  .about-copy__inner,
  .about-reviews__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .about-copy,
    .about-reviews {
      padding: 44px 24px 32px;
    }
  }
</style>
