---
/**
 * CONTACT — a single "contact desk": compact hero with three quick facts, then
 * the ContactDesk panel overlapping it (request form left, navy contact
 * details right; the same panel ContactSection uses on other pages). Then the
 * SEO sheet's "Thin Content" sections (how to contact us, what happens next,
 * when to call right away, areas we serve), the FAQ and the service-area map.
 *
 * The form panel carries id="request", the no-JS target of every "Request
 * Service" link on the site.
 */
import { site, paths } from '@config/site';
import { commonFaqs } from '@config/faqs';
import { phoneHref } from '@lib/tokens';
import { PAGE_HERO_SIZES, HERO_PHOTO_MEDIA } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ContactDesk from '@components/ContactDesk.astro';
import Faq from '@components/Faq.astro';
import ServiceAreasSection from '@components/ServiceAreasSection.astro';
import Icon from '@components/ui/Icon.astro';
import PageCopy from '@components/PageCopy.astro';
import { pageCopy } from '../data/page-copy';
import { parsePageCopy } from '@lib/page-copy';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Contact Sedco Plumbing | El Cajon Plumber — [PHONE]';
const description =
  'Contact Sedco Plumbing, your local El Cajon plumber. Call [PHONE] or request service online. Same-day appointments usually available.';
const path = paths.contact;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Contact' }];

const phone = site.business.phone;
const tel = phoneHref();

const copy = parsePageCopy(pageCopy.contact);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES, media: HERO_PHOTO_MEDIA }}
>
  <Fragment slot="head">
    <PageSchema type="ContactPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    eyebrow="Contact us"
    heading="Contact Sedco Plumbing, Your El Cajon Plumber"
    intro="Contact Sedco Plumbing, your El Cajon plumber, by phone at (619) 714-0027 or with the service request form below. When you need to contact a plumber in El Cajon quickly, calling is fastest, and same-day appointments are usually available. You can also schedule plumbing service in El Cajon or anywhere in San Diego County online."
    ctas={false}
    overlap
  >
    <ul class="facts" slot="below">
      <li><Icon name="phone" size={20} /><strong>Call any hour, Mon–Sat</strong></li>
      <li><Icon name="clock" size={20} /><strong>30-minute callback</strong></li>
      <li><Icon name="free-estimate" size={20} /><strong>Free estimate, no trip charge</strong></li>
    </ul>
  </PageHero>

  <section class="desk" id="request" aria-label="Send a request or contact us">
    <a class="desk__call-mobile btn btn--call btn--lg" href={tel}>
      <Icon name="phone" size={22} />Call {phone}
    </a>

    <ContactDesk id="contact" source="contact-page" mobileForm />
  </section>

  <PageCopy sections={copy.sections} label="How to contact us and what happens next" />

  <Faq faqs={commonFaqs} mobileCall />

  <ServiceAreasSection />
</BaseLayout>

<style>
  /* ---- hero quick facts ---- */

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    list-style: none;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--blue-200);
  }

  .facts :global(svg) {
    flex: none;
    color: var(--yellow-500);
  }

  .facts strong {
    font-weight: 600;
    color: var(--white);
  }

  /* ---- the contact desk ---- */

  .desk {
    position: relative;
    z-index: 2;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: -104px auto 0;
    padding: 0 var(--gutter);
  }

  .desk__call-mobile {
    display: none;
  }

  /* ---- reflow ---- */

  @media (max-width: 768px) {
    .facts {
      flex-direction: column;
      gap: 10px;
    }

    .desk {
      margin-top: 16px;
      padding: 0 var(--section-inset);
    }

    .desk__call-mobile {
      display: flex;
      width: 100%;
      margin-bottom: 16px;
    }

  }
</style>
