---
/**
 * CONTACT — design "Sedco Contact".
 * Hero → four info cards (call, hours, where we work, licence) → request
 * form section (#request, the no-JS target of every "Request Service" link)
 * → FAQ → service-area map.
 */
import { site, paths } from '@config/site';
import { commonFaqs } from '@config/faqs';
import { phoneHref, emailHref, isPlaceholder } from '@lib/tokens';
import { PAGE_HERO_SIZES } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ContactSection from '@components/ContactSection.astro';
import Faq from '@components/Faq.astro';
import ServiceAreasSection from '@components/ServiceAreasSection.astro';
import Icon from '@components/ui/Icon.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Contact Sedco Plumbing | El Cajon Plumber — [PHONE]';
const description =
  'Contact Sedco Plumbing in El Cajon, CA. Request service anywhere in San Diego County — same-day appointments available. Call [PHONE] or book online.';
const path = paths.contact;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Contact' }];
const email = site.business.email;
const hasEmail = !isPlaceholder(email) && email.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES }}
>
  <Fragment slot="head">
    <PageSchema type="ContactPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    eyebrow="Contact us"
    heading="Contact Sedco Plumbing"
    intro="Contact a plumber in El Cajon at any hour from Monday to Saturday, or send a request and we’ll call you back within 30 minutes to schedule a visit. Every visit starts with a free estimate, with no trip charge."
  />

  <section class="info" aria-label="How to reach us">
    <ul class="info__grid">
      <li class="info__card">
        <span class="info__icon"><Icon name="phone" size={24} /></span>
        <p class="info__title">Call us</p>
        <a class="info__phone" href={phoneHref()}>{site.business.phone}</a>
        <p class="info__text">Someone picks up at any hour, Monday to Saturday.</p>
        {hasEmail && <p class="info__text">Or email <a href={emailHref()}>{email}</a></p>}
      </li>
      <li class="info__card">
        <span class="info__icon"><Icon name="clock" size={24} /></span>
        <p class="info__title">Opening hours</p>
        <p class="info__text">Open 24 hours, Monday to Saturday. Need a same-day plumber in El Cajon? Same-day visits are available.</p>
        <p class="info__text">Closed Sunday. Requests sent on Sunday are answered on Monday.</p>
      </li>
      <li class="info__card">
        <span class="info__icon"><Icon name="map-pin" size={24} /></span>
        <p class="info__title">Where we work</p>
        <p class="info__text">
          Based in {site.business.locality}, {site.business.region}, serving homes and businesses across{' '}
          <a href={paths.areasHub}>San Diego County</a>. We come to you, so there's no storefront to visit.
        </p>
      </li>
      <li class="info__card">
        <span class="info__icon"><Icon name="licensed" size={24} /></span>
        <p class="info__title">Licensed contractor</p>
        <p class="info__text">
          Licensed CA {site.business.licenseClass} plumbing contractor, with a 30-day guarantee on all work.
        </p>
      </li>
    </ul>
    <p class="info__safety">
      <Icon name="alert-circle" size={20} />
      <span><strong>If you smell gas</strong>, leave the building first and call your gas utility, then call us.</span>
    </p>
  </section>

  <ContactSection />

  <Faq faqs={commonFaqs} mobileCall />

  <ServiceAreasSection />
</BaseLayout>

<style>
  .info {
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 40px var(--gutter) 0;
  }

  .info__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }

  .info__card {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--white);
  }

  .info__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--r-md);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .info__title {
    margin-top: 22px;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 20px;
    color: var(--navy-800);
  }

  .info__phone {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 24px;
    color: var(--navy-800);
    text-decoration: none;
  }

  .info__phone:hover {
    color: var(--blue-700);
  }

  .info__text {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--slate-600);
  }

  .info__safety {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 16px;
    padding: 16px 20px;
    border-left: 4px solid var(--yellow-500);
    border-radius: var(--r-md);
    background: var(--yellow-100);
    font-size: 16px;
    line-height: 1.5;
    color: var(--navy-800);
  }

  .info__safety :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--gold-text);
  }

  @media (max-width: 1099px) {
    .info__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .info {
      padding: 28px 16px 0;
    }

    .info__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .info__card {
      padding: 22px;
    }
  }
</style>
