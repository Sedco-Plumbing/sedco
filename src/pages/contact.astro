---
/**
 * CONTACT — a single "contact desk": compact hero with three quick facts, then
 * the ContactDesk panel overlapping it (request form left, navy contact
 * details right; the same panel ContactSection uses on other pages). Then what
 * happens after a request, the FAQ and the service-area map.
 *
 * The form panel carries id="request", the no-JS target of every "Request
 * Service" link on the site.
 */
import { site, paths } from '@config/site';
import { commonFaqs } from '@config/faqs';
import { phoneHref } from '@lib/tokens';
import { PAGE_HERO_SIZES, HERO_PHOTO_MEDIA } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ContactDesk from '@components/ContactDesk.astro';
import Faq from '@components/Faq.astro';
import ServiceAreasSection from '@components/ServiceAreasSection.astro';
import Icon from '@components/ui/Icon.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Contact Sedco Plumbing | El Cajon Plumber — [PHONE]';
const description =
  'Contact Sedco Plumbing in El Cajon, CA. Request service anywhere in San Diego County — same-day appointments available. Call [PHONE] or book online.';
const path = paths.contact;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Contact' }];

const phone = site.business.phone;
const tel = phoneHref();

const steps = [
  {
    title: 'We call you back',
    text: 'Within 30 minutes, Monday to Saturday, to talk about the problem and schedule plumbing service in El Cajon or wherever you are in San Diego County.',
  },
  {
    title: 'A plumber comes to you',
    text: 'Same-day visits are available, and there is no trip charge for coming out to see the problem.',
  },
  {
    title: 'You get a free estimate',
    text: 'A clear price before any work starts. Nothing goes ahead until you say yes, and the work is guaranteed for 30 days.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES, media: HERO_PHOTO_MEDIA }}
>
  <Fragment slot="head">
    <PageSchema type="ContactPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    eyebrow="Contact us"
    heading="Contact Sedco Plumbing"
    intro="Contact a plumber in El Cajon at any hour from Monday to Saturday. Call us, or send a request below and we’ll call you back within 30 minutes."
    ctas={false}
    overlap
  >
    <ul class="facts" slot="below">
      <li><Icon name="phone" size={20} /><strong>Call any hour, Mon–Sat</strong></li>
      <li><Icon name="clock" size={20} /><strong>30-minute callback</strong></li>
      <li><Icon name="free-estimate" size={20} /><strong>Free estimate, no trip charge</strong></li>
    </ul>
  </PageHero>

  <section class="desk" id="request" aria-label="Send a request or contact us">
    <a class="desk__call-mobile btn btn--call btn--lg" href={tel}>
      <Icon name="phone" size={22} />Call {phone}
    </a>

    <ContactDesk id="contact" source="contact-page" mobileForm />
  </section>

  <section class="next" aria-labelledby="next-heading">
    <div class="container">
      <p class="eyebrow">What happens next</p>
      <h2 class="next__title" id="next-heading">After You Send a Request</h2>
      <ol class="next__steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="next__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="next__step-title">{step.title}</h3>
              <p class="next__step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Faq faqs={commonFaqs} mobileCall />

  <ServiceAreasSection />
</BaseLayout>

<style>
  /* ---- hero quick facts ---- */

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    list-style: none;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--blue-200);
  }

  .facts :global(svg) {
    flex: none;
    color: var(--yellow-500);
  }

  .facts strong {
    font-weight: 600;
    color: var(--white);
  }

  /* ---- the contact desk ---- */

  .desk {
    position: relative;
    z-index: 2;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: -104px auto 0;
    padding: 0 var(--gutter);
  }

  .desk__call-mobile {
    display: none;
  }

  /* ---- what happens next ---- */

  .next {
    padding: 88px 0 24px;
  }

  .next__title {
    margin-top: 10px;
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.02em;
  }

  .next__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 32px;
    list-style: none;
  }

  .next__steps li {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .next__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--yellow-500);
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 15px;
    color: var(--navy-800);
  }

  .next__step-title {
    margin-top: 18px;
    font-weight: 700;
    font-size: 20px;
  }

  .next__step-text {
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--slate-600);
  }

  /* ---- reflow ---- */

  @media (max-width: 959px) {
    .next__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .facts {
      flex-direction: column;
      gap: 10px;
    }

    .desk {
      margin-top: 16px;
      padding: 0 var(--section-inset);
    }

    .desk__call-mobile {
      display: flex;
      width: 100%;
      margin-bottom: 16px;
    }

    .next {
      padding: 56px 0 8px;
    }

    .next__title {
      font-size: 28px;
    }

    .next__steps li {
      padding: 22px;
    }
  }
</style>
