---
/**
 * HOMEPAGE — design "Sedco Homepage v3".
 *
 * Copy is the design's final copy, which is written around the SEO keyword
 * map for this URL (primary "plumber El Cajon"; secondaries "plumbing company
 * El Cajon", "plumbing services San Diego County", "licensed plumber East
 * County San Diego"). Carries the site-wide Plumber (LocalBusiness) entity and
 * FAQPage schema, and links to every service and every town page.
 */
import { paths } from '@config/site';
import type { Faq as FaqItem } from '@lib/types';

import BaseLayout from '@layouts/BaseLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import { HOME_HERO_SIZES } from '@lib/media';
import HowItWorks from '@components/home/HowItWorks.astro';
import ServicesGrid from '@components/ServicesGrid.astro';
import ReviewsMarquee from '@components/ReviewsMarquee.astro';
import ServiceAreasSection from '@components/ServiceAreasSection.astro';
import AboutSplit from '@components/AboutSplit.astro';
import Faq from '@components/Faq.astro';
import ContactSection from '@components/ContactSection.astro';
import LocalBusinessSchema from '@components/schema/LocalBusinessSchema.astro';
import FaqSchema from '@components/schema/FaqSchema.astro';

const title = 'Plumber in El Cajon & San Diego County | Sedco Plumbing';
const description =
  'Licensed plumber in El Cajon serving East County & San Diego County. Drains, water heaters, leaks & repairs with upfront pricing. Call [PHONE].';

const faqs: FaqItem[] = [
  {
    question: 'Do you charge for estimates?',
    answer: [
      "No, our estimates are free, and there's no call-out fee or trip charge either. Our plumber looks at the problem and tells you the price, and then it's up to you whether we go ahead.",
    ],
  },
  {
    question: 'How quickly can a plumber get to me?',
    answer: [
      "Same-day visits are available from Monday to Saturday, and we're open 24 hours on each of those days. If you send us a request through the website, we'll call you back within 30 minutes to talk about the problem and agree on a time.",
    ],
  },
  {
    question: 'Do you charge more at night or on Saturdays?',
    answer: [
      "No, a call at night or on a Saturday costs the same as one on a weekday afternoon. We're closed on Sundays, so if you send us a request on a Sunday, we'll get back to you on Monday.",
    ],
  },
  {
    question: 'Do you work outside El Cajon?',
    answer: [
      "Yes, we're based in El Cajon, but we take jobs right across San Diego County, and most of our work is in East County towns like [La Mesa](/service-areas/la-mesa/), [Santee](/service-areas/santee/), [Lakeside](/service-areas/lakeside/) and [Alpine](/service-areas/alpine/). Wherever you are, you get the same free estimate and the same prices.",
    ],
  },
  {
    question: 'Are you a licensed plumber?',
    answer: [
      'Yes, Sedco Plumbing is a licensed CA C-36 plumbing contractor, which is the California license for plumbing work, so your job is handled by a licensed plumbing company rather than a general handyman.',
    ],
  },
  {
    question: 'What does your 30-day guarantee cover?',
    answer: [
      "It covers all of our work for 30 days, with no exceptions. If the same problem comes back in that time, for example the same drain blocks up again, we'll come back and fix it at no charge.",
    ],
  },
  {
    question: 'Do you work for landlords and businesses?',
    answer: [
      'Yes, we work for homeowners, landlords, rental managers and businesses alike. If you look after rentals or other properties, our [property management plumbing service](/services/property-management-plumbing/) makes it easy to send us tenant repairs whenever they come up.',
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: HOME_HERO_SIZES }}
>
  <Fragment slot="head">
    <LocalBusinessSchema />
    <FaqSchema faqs={faqs} />
  </Fragment>

  <HomeHero
    heading="El Cajon Plumbers Serving All of San Diego County"
    intro={[
      'When you need reliable plumbing help, having a local team you can count on makes all the difference. Our experienced plumbers provide dependable solutions for leaks, clogged drains, broken fixtures, water heaters, and other plumbing problems throughout El Cajon and surrounding San Diego County communities.',
      'Whether you need a quick repair or help with a larger plumbing issue, we focus on finding the cause of the problem and providing a practical solution. We keep our service straightforward, communicate clearly, and treat your home with care from start to finish.',
    ]}
  />

  <ServicesGrid
    heading="Plumbing Services Across San Diego County"
    intro="Sedco Plumbing provides plumbing services in San Diego County for homeowners, landlords, rental managers and businesses, and since we're based in El Cajon, most of our work is in the East County towns close to home. Every service we offer is listed below, grouped by the kind of problem it solves, so you can find yours quickly and open its page to see how we handle the job."
    formGap
  />

  <ReviewsMarquee />

  <HowItWorks />

  <ServiceAreasSection />

  <AboutSplit
    heading="An El Cajon Plumbing Company With 20 Years of Experience"
    paragraphs={[
      "Our team brings 20 years of plumbing experience to every job, and over that time we've learned that most people want the same few things when they look for a plumber in El Cajon. They want someone who picks up the phone, turns up when they say they will, explains the problem in plain words and then charges the price they quoted.",
      "That's why we give free estimates, keep our prices the same day and night, and guarantee every job for 30 days with no exceptions. As a licensed CA C-36 plumbing contractor, we look after every home, rental and business we work in as carefully as we'd want someone to look after our own.",
    ]}
    link={{ href: paths.about, label: 'Learn more about Sedco Plumbing' }}
  />

  <Faq faqs={faqs} mobileCall />

  <ContactSection />
</BaseLayout>
