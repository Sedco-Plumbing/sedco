---
/**
 * PRIVACY POLICY — linked from the footer (guide Part 2).
 *
 * Client-approved (legal.privacyPolicyApproved in src/config/site.ts). It
 * describes what this website collects: contact form submissions via
 * Web3Forms, and analytics. Indexable and in the sitemap, like any public page
 * (SEO implementation sheet, Technical Fix #5). If the policy changes, bump
 * legal.privacyPolicyUpdated so the "Last updated" date stays accurate.
 */
import { site, paths } from '@config/site';
import { th, emailHref } from '@lib/tokens';

import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';

const title = `Privacy Policy | ${site.business.name}`;
const description = `How ${site.business.name} collects and uses the information you submit through this website.`;
const path = paths.privacy;

const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Privacy Policy' }];

const updated = site.legal.privacyPolicyUpdated;
---

<BaseLayout title={title} description={description} path={path} crumbs={crumbs}>
  <header class="legal-head">
    <div class="legal-head__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={paths.home}>Home</a><Icon name="chevron-right" size={14} /></li>
          <li><span aria-current="page">Privacy Policy</span></li>
        </ol>
      </nav>
      <h1 class="legal-head__title">Privacy Policy</h1>
      <p class="legal-head__updated">Last updated {updated}</p>
    </div>
  </header>

  <section class="legal">
    <div class="legal__inner">
      <article class="prose">

        <h2>What We Collect</h2>
        <p>
          When you send us a service request through this website, we collect the details you enter: your
          name, phone number, email address (if you give one), service address city, the service you need,
          your preferred time for us to call or visit, and your description of the problem, along with the
          address of the page you sent it from. We collect this only because
          you chose to send it to us.
        </p>
        <p>
          Our form is processed by Web3Forms, which delivers the submission to our email inbox. We do not
          store form submissions on this website.
        </p>

        <h2>How We Use It</h2>
        <p>
          We use what you send to respond to your request, schedule service, and follow up about the work. We
          do not sell your information, and we do not share it with anyone except where it is necessary to
          perform the service you asked for.
        </p>

        <h2>Analytics</h2>
        <p>
          If web analytics are enabled on this site, they collect aggregate information about how pages are
          used — such as which pages are visited and roughly where visitors are located. This is used to
          improve the website and is not tied to your name or contact details.
        </p>

        <h2>Cookies</h2>
        <p>
          This website does not set advertising or tracking cookies of its own. Any cookies present come from
          analytics, if enabled, and can be blocked through your browser settings without affecting how the
          site works.
        </p>

        <h2>Your Choices</h2>
        <p>
          You can ask us what information we hold about you, ask us to correct it, or ask us to delete it.
          Email <a href={emailHref()}><span set:html={th('[EMAIL]')} /></a> or call
          <span set:html={th('[PHONE]')} /> and we will take care of it.
        </p>

        <h2>Contact Us</h2>
        <p>
          {site.business.name} · {site.business.locality}, {site.business.region} ·
          <span set:html={th('[PHONE]')} /> · <span set:html={th('[EMAIL]')} />
          <br />
          California {site.business.licenseClass} plumbing contractor license.
        </p>

        <p>
          Questions about a service request instead? Use our <a href={paths.contact}>contact page</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-head {
    margin: 0 var(--section-inset);
    padding: 56px clamp(24px, 5.5vw, 105px);
    border-radius: var(--r-section);
    background: var(--navy-800);
  }

  .legal-head__inner,
  .legal__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    list-style: none;
    font-size: 15px;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--blue-200);
  }

  .crumbs a {
    color: var(--blue-200);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .crumbs [aria-current] {
    font-weight: 600;
    color: var(--white);
  }

  .crumbs :global(svg) {
    color: var(--blue-300);
  }

  .legal-head__title {
    margin-top: 28px;
    font-weight: 800;
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--white);
  }

  .legal-head__updated {
    margin-top: 12px;
    font-size: 15px;
    color: var(--blue-200);
  }

  .legal {
    padding: 56px var(--gutter) 88px;
  }

  @media (max-width: 768px) {
    .legal-head {
      padding: 28px 20px 32px;
    }

    .legal-head__title {
      margin-top: 20px;
      font-size: 34px;
    }

    .legal {
      padding: 40px 24px 56px;
    }
  }
</style>
