---
/**
 * REVIEWS — design "Sedco Reviews".
 * Hero with the 5.0 rating card → "Recent Reviews" with source filter tabs
 * and a masonry of every review → "Had a Job Done by Sedco?" → FAQ → contact.
 *
 * No Review or AggregateRating markup: the reviews are curated from the
 * client's Yelp and Foursquare profiles (src/config/reviews.ts), and Google
 * allows that markup only for first-party reviews collected on the site.
 */
import { paths, getCity } from '@config/site';
import { reviews } from '@config/reviews';
import { commonFaqs } from '@config/faqs';
import { PAGE_HERO_SIZES, HERO_PHOTO_MEDIA } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Faq from '@components/Faq.astro';
import ContactSection from '@components/ContactSection.astro';
import Stars from '@components/ui/Stars.astro';
import GoogleReviewButton from '@components/ui/GoogleReviewButton.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Sedco Plumbing Reviews | Top Rated Plumber in El Cajon';
const description =
  'Read what El Cajon and East County customers say about Sedco Plumbing. See why homeowners call us the best plumber in El Cajon. Call [PHONE].';
const path = paths.reviews;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Reviews' }];

const sources = [...new Set(reviews.map((r) => r.source))];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES, media: HERO_PHOTO_MEDIA }}
>
  <Fragment slot="head">
    <PageSchema type="WebPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    eyebrow="Customer reviews"
    heading="Sedco Plumbing Reviews From El Cajon and East County Customers"
    intro="These Sedco Plumbing reviews come from customers in El Cajon and East County who called us for drain cleaning, water heaters, leaks and everyday repairs. If you are looking for the best plumber in El Cajon, hearing from real neighbours is a good place to start, and it is why so many call us a top rated plumber in El Cajon."
  >
    <div class="rating-card" slot="aside">
      <div class="rating-card__top">
        <span class="rating-card__score">5.0</span>
        <span>
          <Stars size={24} label="Rated 5 out of 5" />
          <span class="rating-card__label">Rated on Google</span>
        </span>
      </div>
      <p class="rating-card__text">
        Reviews from homeowners, landlords and businesses across San Diego County, on Google, Yelp
        and Foursquare.
      </p>
      <GoogleReviewButton variant="text" label="Review us on Google" class="rating-card__link" />
    </div>
  </PageHero>

  <section class="recent" aria-labelledby="recent-heading">
    <div class="container">
      <div class="recent__head">
        <h2 class="recent__title" id="recent-heading">Recent Reviews</h2>
        <div class="tabs" role="group" aria-label="Filter reviews by source" data-review-filter>
          <button type="button" aria-pressed="true" data-source="all">All reviews</button>
          {sources.map((source) => <button type="button" aria-pressed="false" data-source={source}>{source}</button>)}
        </div>
      </div>

      <ul class="masonry">
        {
          reviews.map((review) => {
            const city = review.city ? getCity(review.city) : null;
            return (
              <li class="card" data-source={review.source}>
                <Stars size={18} label="5 out of 5 stars" />
                <blockquote>“{review.quote}”</blockquote>
                <div class="card__who">
                  <span class="card__avatar" aria-hidden="true">{review.name.charAt(0)}</span>
                  <span class="card__name">
                    <strong>{review.name}</strong>
                    <span>{city ? `${review.service} · ${city.name}` : review.service}</span>
                  </span>
                  <span class="card__source">{review.source}</span>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="ask" aria-labelledby="ask-heading">
    <div class="ask__panel">
      <div>
        <h2 class="ask__title" id="ask-heading">Had a Job Done by Sedco?</h2>
        <p class="ask__text">We read every review, and it helps other homeowners find a plumber they can trust.</p>
      </div>
      <GoogleReviewButton />
    </div>
  </section>

  <Faq faqs={commonFaqs} mobileCall />

  <ContactSection />
</BaseLayout>

<style>
  .rating-card {
    padding: 32px;
    border-radius: var(--r-2xl);
    background: var(--white);
    box-shadow: var(--shadow-form);
  }

  .rating-card__top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .rating-card__score {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--navy-800);
  }

  .rating-card__label {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    font-weight: 600;
    color: var(--navy-800);
  }

  .rating-card__text {
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--slate-600);
  }

  .recent {
    padding: 80px 0 40px;
  }

  .recent__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .recent__title {
    font-weight: 800;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tabs button {
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--slate-300);
    border-radius: var(--r-pill);
    background: var(--white);
    font-size: 15px;
    font-weight: 600;
    color: var(--navy-800);
    cursor: pointer;
    transition:
      background-color var(--t-base) ease,
      color var(--t-base) ease,
      border-color var(--t-base) ease;
  }

  .tabs button:hover {
    border-color: var(--navy-800);
  }

  .tabs button[aria-pressed='true'] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: var(--yellow-500);
  }

  .masonry {
    column-count: 3;
    column-gap: 18px;
    margin-top: 28px;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 18px;
    padding: 28px;
    break-inside: avoid;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .card blockquote {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--navy-800);
  }

  .card__who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid #eef1f5;
  }

  .card__avatar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--navy-800);
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--yellow-500);
  }

  .card__name {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-size: 14px;
    line-height: 1.35;
    color: var(--slate-500);
  }

  .card__name strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--navy-800);
  }

  .card__source {
    flex: none;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--sky-50);
    font-size: 13px;
    font-weight: 600;
    color: var(--slate-600);
  }

  .ask {
    padding: 24px var(--gutter) 24px;
  }

  .ask__panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 48px 56px;
    border-radius: var(--r-2xl);
    background: var(--yellow-50);
  }

  .ask__title {
    font-weight: 800;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .ask__text {
    margin-top: 10px;
    font-size: 17px;
    color: var(--slate-600);
  }

  .rating-card :global(.rating-card__link) {
    margin-top: 16px;
  }

  @media (max-width: 1099px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (max-width: 768px) {
    .rating-card {
      padding: 24px;
    }

    .rating-card__score {
      font-size: 52px;
    }

    .recent {
      padding: 44px 0 24px;
    }

    .recent__title {
      font-size: 28px;
    }

    .masonry {
      column-count: 1;
    }

    .card {
      padding: 22px;
    }

    .ask {
      padding: 8px 16px 8px;
    }

    .ask__panel {
      padding: 28px 22px;
    }

    .ask__title {
      font-size: 24px;
    }
  }
</style>

<script>
  const filter = document.querySelector<HTMLElement>('[data-review-filter]');
  if (filter) {
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-source]')];
    const cards = [...document.querySelectorAll<HTMLElement>('.masonry > li[data-source]')];
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const source = button.dataset.source;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        cards.forEach((card) => {
          card.hidden = source !== 'all' && card.dataset.source !== source;
        });
      }),
    );
  }
</script>
