---
/**
 * BLOG POST TEMPLATE — design BlogPost.dc.html.
 *
 * 2026 design language (the handoff has no blog design): navy article head
 * with breadcrumb, category, H1 and byline → lead image → prose column with a
 * sticky call card and "Keep reading" → contact section. The article opens
 * with the highlighted answer box the guide's Part 8 specifies, which also
 * emits FAQPage schema.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import { paths, site } from '@config/site';
import { images } from '@lib/images';

import BaseLayout from '@layouts/BaseLayout.astro';
import ContactSection from '@components/ContactSection.astro';
import Icon from '@components/ui/Icon.astro';
import { phoneHref } from '@lib/tokens';
import FaqSchema from '@components/schema/FaqSchema.astro';
import ArticleSchema from '@components/schema/ArticleSchema.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const data = post.data;
const { Content } = await render(post);

const path = paths.post(post.id);

const crumbs = [
  { name: 'Home', href: paths.home },
  { name: 'Blog', href: paths.blog },
  { name: data.title },
];

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

// Roughly 200 words per minute, for the byline's read-time estimate.
const readMinutes = Math.max(1, Math.round(post.body!.split(/\s+/).length / 200));

// "Keep Reading" — the post's own related list, or the newest other posts.
const relatedEntries = await Promise.all(
  data.related.map((ref) => getEntry('blog', ref.id)),
);
const related = relatedEntries.filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry) && !entry!.data.draft,
);

const fallbackRelated =
  related.length > 0
    ? related
    : (await getCollection('blog', ({ data: d }) => !d.draft))
        .filter((entry) => entry.id !== post.id)
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
        .slice(0, 3);

const keepReading = fallbackRelated.map((entry) => ({
  href: paths.post(entry.id),
  anchor: entry.data.title,
}));

const faqs = data.answerBox
  ? [{ question: data.answerBox.question, answer: data.answerBox.answer }]
  : [];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.metaDescription}
  path={path}
  crumbs={crumbs}
  ogImage={data.featuredImage?.src}
  publishedTime={data.publishDate}
>
  <Fragment slot="head">
    <ArticleSchema
      headline={data.title}
      description={data.metaDescription}
      path={path}
      published={data.publishDate}
      updated={data.updatedDate}
      author={data.author}
      image={data.featuredImage?.src}
    />
    {faqs.length > 0 && <FaqSchema faqs={faqs} />}
  </Fragment>

  <article>
    <header class="post-head">
      <div class="post-head__inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={paths.home}>Home</a><Icon name="chevron-right" size={14} /></li>
            <li><a href={paths.blog}>Blog</a><Icon name="chevron-right" size={14} /></li>
            <li><span aria-current="page">{data.title}</span></li>
          </ol>
        </nav>
        <p class="post-head__cat">{data.category}</p>
        <h1 class="post-head__title">{data.title}</h1>
        <div class="byline">
          <img src="/images/brand/sedco-plumbing-logo-84w.webp" alt="" width="44" height="44" />
          <span>
            <strong>{data.author}</strong>
            <span>
              {dateFormat.format(data.publishDate)} · {readMinutes} min read
              {data.updatedDate && <> · Updated {dateFormat.format(data.updatedDate)}</>}
            </span>
          </span>
        </div>
      </div>
    </header>

    <div class="lead-image">
      <Image
        src={data.featuredImage ?? images.blogDefault.src}
        alt={data.featuredImageAlt || images.blogDefault.alt}
        widths={[720, 1200, 1600]}
        sizes="(max-width: 1230px) calc(100vw - 30px), 1200px"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="post-body">
      <div class="post-body__grid">
        <div class="prose">
          {
            data.answerBox && (
              <aside class="answer-box">
                <h2>{data.answerBox.question}</h2>
                {data.answerBox.answer.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </aside>
            )
          }
          <Content />
          {
            data.internalLinks.length > 0 && (
              <aside class="related-callout">
                <h2>Related From {site.business.name}</h2>
                <ul>
                  {data.internalLinks.map((link) => (
                    <li>
                      <a href={link.href}>{link.anchor}</a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>

        <aside class="post-aside" aria-label="Call or keep reading">
          <div class="post-call on-navy">
            <p class="post-call__title">Need a plumber in East County?</p>
            <p class="post-call__text">Free estimate, no trip charge. Open 24 hours, Monday to Saturday.</p>
            <a class="btn btn--call btn--block" href={phoneHref()}><Icon name="phone" size={18} />{site.business.phone}</a>
            <a class="btn btn--request btn--block" href={`${paths.contact}#request`} data-open-request>Request Service</a>
          </div>
          {
            keepReading.length > 0 && (
              <nav class="keep-reading" aria-label="Keep reading">
                <p class="keep-reading__title">Keep reading</p>
                <ul>
                  {keepReading.map((link) => (
                    <li>
                      <a href={link.href}>{link.anchor}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </aside>
      </div>
    </div>
  </article>

  <ContactSection
    heading="Need a Plumber in East County?"
    intro="Call Sedco Plumbing at {phone} for an honest assessment and an upfront price, anywhere in San Diego County."
  />
</BaseLayout>

<style>
  .post-head {
    margin: 0 var(--section-inset);
    padding: 56px clamp(24px, 5.5vw, 105px) 120px;
    border-radius: var(--r-section);
    background: var(--navy-800);
  }

  .post-head__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    list-style: none;
    font-size: 15px;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--blue-200);
  }

  .crumbs a {
    color: var(--blue-200);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .crumbs [aria-current] {
    font-weight: 600;
    color: var(--white);
  }

  .crumbs :global(svg) {
    color: var(--blue-300);
  }

  .post-head__cat {
    margin-top: 36px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow-500);
  }

  .post-head__title {
    margin-top: 12px;
    font-weight: 800;
    font-size: 50px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--white);
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }

  .byline img {
    border-radius: var(--r-sm);
  }

  .byline > span {
    display: flex;
    flex-direction: column;
    font-size: 15px;
    color: var(--blue-200);
  }

  .byline strong {
    font-weight: 600;
    color: var(--white);
  }

  .lead-image {
    max-width: 1200px;
    margin: -80px auto 0;
    padding: 0 var(--section-inset);
  }

  .lead-image :global(img) {
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: cover;
    border-radius: var(--r-2xl);
    box-shadow: var(--shadow-card);
  }

  .post-body {
    padding: 64px var(--gutter) 24px;
  }

  .post-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 72px;
    align-items: start;
    max-width: var(--container);
    margin: 0 auto;
  }

  .answer-box {
    margin-bottom: 40px;
    padding: 28px;
    border-left: 4px solid var(--yellow-500);
    border-radius: var(--r-lg);
    background: var(--yellow-50);
  }

  .answer-box h2 {
    margin-top: 0;
    font-size: 22px;
  }

  .answer-box p {
    color: var(--navy-800);
  }

  .related-callout {
    margin-top: 48px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .related-callout h2 {
    margin-top: 0;
    font-size: 22px;
  }

  .related-callout ul {
    margin-top: 12px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(th) {
    color: var(--navy-800);
    font-weight: 600;
  }

  .prose :global(img) {
    border-radius: var(--r-lg);
  }

  .post-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .post-call {
    padding: 24px;
    border-radius: var(--r-2xl);
    background: var(--navy-800);
  }

  .post-call__title {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 21px;
    line-height: 1.2;
    color: var(--white);
  }

  .post-call__text {
    margin: 8px 0 18px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--blue-200);
  }

  .post-call .btn {
    height: 50px;
    font-size: 16px;
  }

  .post-call .btn + .btn {
    margin-top: 10px;
  }

  .keep-reading {
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    background: var(--white);
  }

  .keep-reading__title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate-500);
  }

  .keep-reading ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
    list-style: none;
  }

  .keep-reading a {
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }

  .keep-reading a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1099px) {
    .post-body__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-aside {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .post-head {
      padding: 28px 20px 96px;
    }

    .post-head__cat {
      margin-top: 24px;
      font-size: 12px;
    }

    .post-head__title {
      font-size: 32px;
    }

    .post-body {
      padding: 40px 24px 8px;
    }

    .answer-box,
    .related-callout {
      padding: 22px;
    }
  }
</style>
