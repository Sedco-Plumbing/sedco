---
/**
 * BLOG INDEX — 2026 design language (the handoff has no blog design): page
 * hero → featured post → card grid of the rest → contact section.
 * Posts are Keystatic-managed (src/content/blog).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { paths } from '@config/site';
import { images } from '@lib/images';

import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ContactSection from '@components/ContactSection.astro';
import Icon from '@components/ui/Icon.astro';
import { PAGE_HERO_SIZES, HERO_PHOTO_MEDIA } from '@lib/media';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Plumbing Tips & Local Guides | Sedco Plumbing Blog';
const description =
  'Practical plumbing advice for El Cajon and East County homeowners — hard water, slab leaks, water heaters, and local costs. Call [PHONE].';
const path = paths.blog;

const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Blog' }];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const [featured, ...rest] = posts;

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES, media: HERO_PHOTO_MEDIA }}
>
  <Fragment slot="head">
    <PageSchema type="Blog" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    eyebrow="Plumbing tips & local guides"
    heading="Plumbing Advice for East County Homes"
    intro="Local, practical answers from the plumbers who work on these houses every day: hard water, slab leaks, aging pipes, water heaters and what things actually cost in San Diego County."
  />

  {
    posts.length === 0 ? (
      <section class="blog">
        <div class="container">
          <p class="empty-note">
            No posts yet. Publish the first post through the <a href="/keystatic">Keystatic admin</a> and
            it will appear here automatically.
          </p>
        </div>
      </section>
    ) : (
      <section class="blog" aria-label="Articles">
        <div class="container">
          <a class="featured" href={paths.post(featured.id)}>
            <div class="featured__media">
              <Image
                src={featured.data.featuredImage ?? images.blogDefault.src}
                alt={featured.data.featuredImageAlt || images.blogDefault.alt}
                widths={[480, 900]}
                sizes="(max-width: 900px) calc(100vw - 48px), 560px"
              />
              <span class="featured__pill">Featured</span>
            </div>
            <div class="featured__body">
              <span class="cat">{featured.data.category}</span>
              <h2 class="featured__title">{featured.data.title}</h2>
              <p class="featured__excerpt">{featured.data.excerpt}</p>
              <span class="meta">{dateFormat.format(featured.data.publishDate)} · {featured.data.author}</span>
              <span class="more" aria-hidden="true">Read the article<Icon name="arrow-right" size={16} /></span>
            </div>
          </a>

          {rest.length > 0 && (
            <>
              <h2 class="all-title">All Articles</h2>
              <ul class="posts">
                {rest.map((post) => (
                  <li>
                    <a class="post-card" href={paths.post(post.id)}>
                      <span class="cat">{post.data.category}</span>
                      <h3 class="post-card__title">{post.data.title}</h3>
                      <p class="post-card__excerpt">{post.data.excerpt}</p>
                      <span class="meta">{dateFormat.format(post.data.publishDate)}</span>
                      <span class="more" aria-hidden="true">Read more<Icon name="arrow-right" size={16} /></span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </section>
    )
  }

  <ContactSection
    heading="Have a Plumbing Question We Haven't Covered?"
    intro="Call Sedco Plumbing at {phone} and ask. We'd rather explain your options over the phone than sell you a visit you don't need."
  />
</BaseLayout>

<style>
  .blog {
    padding: 72px 0 24px;
  }

  .empty-note {
    font-size: 17px;
    color: var(--slate-600);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    background: var(--white);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--t-base) ease,
      transform var(--t-base) ease;
  }

  .featured:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .featured__media {
    position: relative;
    min-height: 320px;
  }

  .featured__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured__pill {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--yellow-500);
    font-size: 13px;
    font-weight: 700;
    color: var(--navy-800);
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 40px;
  }

  .cat {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-600);
  }

  .featured__title {
    font-weight: 800;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .featured__excerpt,
  .post-card__excerpt {
    font-size: 16px;
    line-height: 1.6;
    color: var(--slate-600);
  }

  .meta {
    font-size: 14px;
    color: var(--slate-500);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-weight: 600;
    color: var(--blue-600);
  }

  .all-title {
    margin-top: 64px;
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.02em;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 24px;
    list-style: none;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 28px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--yellow-500);
    border-radius: var(--r-xl);
    background: var(--white);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--t-base) ease,
      transform var(--t-base) ease;
  }

  .post-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .post-card__title {
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
  }

  @media (max-width: 959px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured__media {
      min-height: 220px;
      aspect-ratio: 16 / 9;
    }

    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .blog {
      padding: 40px 0 8px;
    }

    .featured__body {
      padding: 24px;
    }

    .featured__title {
      font-size: 24px;
    }

    .posts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
