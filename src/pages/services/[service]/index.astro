---
/**
 * SERVICE PAGE — one per service, from src/content/services/*.yaml.
 *
 * URL, title tag, description, H1 and body copy all come from the content
 * entry (the SEO team's copy, aligned with the keyword map); the layout is
 * the 2026 design via ServicePage. Carries Service + FAQPage schema, and
 * BreadcrumbList through the layout.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { getService, paths } from '@config/site';
import { catalogService } from '@config/catalog';
import { SERVICE_HERO_PHOTO_SIZES, SERVICE_HERO_ART_SIZES } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import ServicePage from '@components/service/ServicePage.astro';
import LocalBusinessSchema from '@components/schema/LocalBusinessSchema.astro';
import ServiceSchema from '@components/schema/ServiceSchema.astro';
import FaqSchema from '@components/schema/FaqSchema.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('services');
  return entries.map((entry) => ({
    params: { service: entry.data.service },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const data = entry.data;
const service = getService(data.service);
const item = catalogService(service.slug);
const path = paths.service(service.slug);

const crumbs = [
  { name: 'Home', href: paths.home },
  { name: 'Services', href: paths.servicesHub },
  { name: service.name },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={path}
  crumbs={crumbs}
  drawerService={item.name}
  preloadImage={[
    { name: 'hero/sedco-plumber-el-cajon', sizes: SERVICE_HERO_PHOTO_SIZES, media: '(min-width: 769px)' },
    { name: item.image, sizes: SERVICE_HERO_ART_SIZES, media: '(max-width: 768px)' },
  ]}
>
  <Fragment slot="head">
    <LocalBusinessSchema />
    <ServiceSchema serviceType={service.name} path={path} description={service.schemaDescription} />
    {data.faqs.length > 0 && <FaqSchema faqs={data.faqs} />}
  </Fragment>

  <ServicePage data={data} service={service} crumbs={crumbs} />
</BaseLayout>
