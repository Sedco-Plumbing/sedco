---
/**
 * SERVICE x CITY PAGE TEMPLATE — guide Part 6.
 *
 * The highest-intent pages (e.g. "slab leak repair La Mesa"). Internal linking
 * per guide Part 7.2: UP to the parent service page and the city page, ACROSS
 * to one sibling combo, plus Contact.
 *
 * Every one of these carries unique local copy from the guide — the
 * anti-doorway rule means no page is a clone with the city name swapped.
 * Layout: the 2026 service design (ServicePage), with town chips linking
 * up to the town pages and across to sibling service × town pages.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { getCity, getService, paths } from '@config/site';
import { catalogService } from '@config/catalog';
import { SERVICE_HERO_PHOTO_SIZES, SERVICE_HERO_ART_SIZES } from '@lib/media';
import ServicePage from '@components/service/ServicePage.astro';

import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceSchema from '@components/schema/ServiceSchema.astro';
import FaqSchema from '@components/schema/FaqSchema.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('serviceCity');
  return entries.map((entry) => ({
    params: { service: entry.data.service, city: entry.data.city },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const data = entry.data;

const service = getService(data.service);
const city = getCity(data.city);
const path = paths.serviceCity(service.slug, city.slug);

const crumbs = [
  { name: 'Home', href: paths.home },
  { name: 'Services', href: paths.servicesHub },
  { name: service.name, href: paths.service(service.slug) },
  { name: `${city.name}, CA` },
];
const item = catalogService(service.slug);
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={path}
  crumbs={crumbs}
  drawerService={item.name}
  drawerCity={city.name}
  preloadImage={[
    { name: 'hero/sedco-plumber-el-cajon', sizes: SERVICE_HERO_PHOTO_SIZES, media: '(min-width: 769px)' },
    { name: item.image, sizes: SERVICE_HERO_ART_SIZES, media: '(max-width: 768px)' },
  ]}
>
  <Fragment slot="head">
    <ServiceSchema serviceType={service.name} path={path} city={city.name} />
    {data.faqs.length > 0 && <FaqSchema faqs={data.faqs} />}
  </Fragment>

  <ServicePage data={data} service={service} city={city} crumbs={crumbs} />
</BaseLayout>
