---
/**
 * SERVICES HUB — design "Sedco All Services".
 * Hero (with the four group pills) → services grid → FAQ → contact.
 * Every card links to its live service URL (keyword map).
 */
import { paths } from '@config/site';
import { catalogGroups } from '@config/catalog';
import { commonFaqs } from '@config/faqs';
import { PAGE_HERO_SIZES } from '@lib/media';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ServicesGrid from '@components/ServicesGrid.astro';
import Faq from '@components/Faq.astro';
import ContactSection from '@components/ContactSection.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Plumbing Services in El Cajon & San Diego County | Sedco';
const description =
  'Everyday repairs, drain and sewer, remodels, water heaters, and water and gas lines across El Cajon and San Diego County. Free estimates, no trip charge.';
const path = paths.servicesHub;
const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Services' }];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  crumbs={crumbs}
  inlineCrumbs
  preloadImage={{ name: 'hero/sedco-plumber-el-cajon', sizes: PAGE_HERO_SIZES }}
>
  <Fragment slot="head">
    <PageSchema type="CollectionPage" name={title} description={description} path={path} />
  </Fragment>

  <PageHero
    crumbs={crumbs}
    heading="Plumbing Services in El Cajon and San Diego County"
    intro="From everyday repairs and blocked drains to remodels, water heaters, and water and gas lines, Sedco Plumbing handles plumbing for homes, rentals and businesses. Every visit starts with a free estimate, with no trip charge."
  >
    <ul class="group-pills" slot="below" aria-label="Service groups">
      {
        catalogGroups.map((group) => (
          <li>
            <a href={`#group-${group.key}`}>{group.menuTitle}</a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <ServicesGrid />

  <Faq faqs={commonFaqs} mobileCall />

  <ContactSection />
</BaseLayout>

<style>
  .group-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .group-pills a {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border: 1.5px solid var(--blue-400);
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
    transition:
      background-color var(--t-base) ease,
      border-color var(--t-base) ease,
      color var(--t-base) ease;
  }

  .group-pills a:hover {
    border-color: var(--yellow-500);
    background: var(--yellow-500);
    color: var(--navy-800);
  }

  .group-pills a:focus-visible {
    outline-color: var(--blue-300);
  }
</style>
