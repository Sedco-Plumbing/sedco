---
/**
 * Shared document shell: head/SEO, header, breadcrumbs, footer, and the
 * persistent mobile click-to-call bar.
 *
 * JSON-LD is passed in through the `head` slot so it lands in <head> as the
 * guide specifies (Part 7.1).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { Font } from 'astro:assets';

import { site } from '@config/site';
import type { Crumb } from '@lib/types';
import Seo from '@components/Seo.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import PreloadImage from '@components/ui/PreloadImage.astro';
import RequestDrawer from '@components/RequestDrawer.astro';
import MobileCallBar from '@components/MobileCallBar.astro';
import type { ImageKey } from '@lib/media';

type PreloadSpec = { name: ImageKey; sizes?: string; media?: string };

interface Props {
  title: string;
  description: string;
  path: string;
  /**
   * Breadcrumb trail for the BreadcrumbList schema; omit on the homepage. Pages
   * render the visible trail themselves, inside their hero.
   */
  crumbs?: Crumb[];
  ogImage?: string;
  publishedTime?: Date;
  noindex?: boolean;
  /**
   * The page's LCP image(s), preloaded in <head>. Match `sizes` to the rendered
   * <img>; pass one entry per `media` query for an art-directed <picture>.
   */
  preloadImage?: PreloadSpec | PreloadSpec[];
  /** Service pre-selected in the Request drawer (catalog name) */
  drawerService?: string;
}

const {
  title,
  description,
  path,
  crumbs,
  ogImage,
  publishedTime,
  noindex,
  preloadImage,
  drawerService,
} = Astro.props;
const ga4 = site.integrations.ga4;
const gtm = site.integrations.gtm;
const googleSiteVerification = site.integrations.googleSiteVerification;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      gtm && (
        <script is:inline define:vars={{ gtm }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtm);
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B2545" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-inter" preload />
    {
      preloadImage &&
        [preloadImage].flat().map((spec) => (
          <PreloadImage name={spec.name} sizes={spec.sizes} media={spec.media} />
        ))
    }
    <meta name="generator" content={Astro.generator} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      publishedTime={publishedTime}
      noindex={noindex}
    />

    {crumbs && crumbs.length > 1 && <BreadcrumbSchema crumbs={crumbs} />}
    <slot name="head" />

    {
      ga4 && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
  </head>

  <body>
    {
      gtm && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtm}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <MobileCallBar />
    <RequestDrawer service={drawerService} />
  </body>
</html>
