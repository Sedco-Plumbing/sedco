---
/**
 * Shared document shell: head/SEO, header, breadcrumbs, footer, and the
 * persistent mobile click-to-call bar.
 *
 * JSON-LD is passed in through the `head` slot so it lands in <head> as the
 * guide specifies (Part 7.1).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { Font } from 'astro:assets';

import { site } from '@config/site';
import type { Crumb } from '@lib/types';
import Seo from '@components/Seo.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import PreloadImage from '@components/ui/PreloadImage.astro';
import RequestDrawer from '@components/RequestDrawer.astro';
import MobileCallBar from '@components/MobileCallBar.astro';
import type { ImageKey } from '@lib/media';

type PreloadSpec = { name: ImageKey; sizes?: string; media?: string };

interface Props {
  title: string;
  description: string;
  path: string;
  /**
   * Breadcrumb trail for the BreadcrumbList schema; omit on the homepage. Pages
   * render the visible trail themselves, inside their hero.
   */
  crumbs?: Crumb[];
  ogImage?: string;
  publishedTime?: Date;
  noindex?: boolean;
  /** Emit the self-referencing canonical (off only for the 404 page) */
  canonical?: boolean;
  /**
   * The page's LCP image(s), preloaded in <head>. Match `sizes` to the rendered
   * <img>; pass one entry per `media` query for an art-directed <picture>.
   */
  preloadImage?: PreloadSpec | PreloadSpec[];
  /** The page's service, pre-selected in the Request drawer (catalog name) */
  drawerService?: string;
  /** The page's town, pre-selected in the Request drawer (city name) */
  drawerCity?: string;
}

const {
  title,
  description,
  path,
  crumbs,
  ogImage,
  publishedTime,
  noindex,
  canonical = true,
  preloadImage,
  drawerService,
  drawerCity,
} = Astro.props;
const ga4 = site.integrations.ga4;
const gtm = site.integrations.gtm;
const googleSiteVerification = site.integrations.googleSiteVerification;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /*
       * GTM and GA4, loaded once the page is ready: on the visitor's first
       * scroll, tap, click or key press, or 5 seconds after the page loads,
       * whichever comes first. Their ~470 KB of script then never competes
       * with the first render on a phone. The dataLayer and gtag() queue
       * exist from the start, so nothing is lost: GA4's config (page_view)
       * and any dataLayer events (e.g. form_submit_lead) are processed as
       * soon as the scripts arrive.
       */
      (gtm || ga4) && (
        <script is:inline define:vars={{ gtm, ga4 }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          if (gtm) window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          if (ga4) {
            window.gtag('js', new Date());
            window.gtag('config', ga4);
          }
          (function () {
            var loaded = false;
            var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
            var add = function (src) {
              var script = document.createElement('script');
              script.async = true;
              script.src = src;
              document.head.appendChild(script);
            };
            var load = function () {
              if (loaded) return;
              loaded = true;
              events.forEach(function (name) {
                window.removeEventListener(name, load);
              });
              if (gtm) add('https://www.googletagmanager.com/gtm.js?id=' + gtm);
              if (ga4) add('https://www.googletagmanager.com/gtag/js?id=' + ga4);
            };
            events.forEach(function (name) {
              window.addEventListener(name, load, { once: true, passive: true });
            });
            var later = function () {
              setTimeout(load, 5000);
            };
            if (document.readyState === 'complete') later();
            else window.addEventListener('load', later);
          })();
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B2545" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-inter" preload />
    {
      preloadImage &&
        [preloadImage].flat().map((spec) => (
          <PreloadImage name={spec.name} sizes={spec.sizes} media={spec.media} />
        ))
    }
    <meta name="generator" content={Astro.generator} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      publishedTime={publishedTime}
      noindex={noindex}
      canonical={canonical}
    />

    {crumbs && crumbs.length > 1 && <BreadcrumbSchema crumbs={crumbs} />}
    <slot name="head" />
  </head>

  <body>
    {
      gtm && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtm}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <MobileCallBar />
    <RequestDrawer service={drawerService} city={drawerCity} />
  </body>
</html>
