# Cloudflare Pages/Workers headers. The adapter appends its own immutable
# Cache-Control rule for /_astro/* at build time.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Pre-optimized images (public/images). Cached for a year: every file name
# carries its width, so a replaced image must ship under a NEW file name
# (e.g. -v2) or visitors keep the old one until their cache expires.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The Keystatic admin must not be framed or indexed.
/keystatic/*
  X-Robots-Tag: noindex, nofollow
